    ]

# Mouse Input Structures
PUL = ctypes.POINTER(ctypes.c_ulong)
class MOUSEINPUT(ctypes.Structure):
    _fields_ = [
        ("dx",          ctypes.c_long),
        ("dy",          ctypes.c_long),
        ("mouseData",   ctypes.c_ulong),
        ("dwFlags",     ctypes.c_ulong),
        ("time",        ctypes.c_ulong),
        ("dwExtraInfo", PUL),
    ]

class _INPUT_UNION(ctypes.Union):
    _fields_ = [("mi", MOUSEINPUT)]

class INPUT(ctypes.Structure):
    _fields_ = [("type", ctypes.c_ulong), ("_input", _INPUT_UNION)]

MOUSEEVENTF_MOVE     = 0x0001
MOUSEEVENTF_LEFTDOWN = 0x0002
MOUSEEVENTF_LEFTUP   = 0x0004
MOUSEEVENTF_ABSOLUTE = 0x8000
INPUT_MOUSE          = 0

def send_mouse_click(screen_x: int, screen_y: int):
    sw = user32.GetSystemMetrics(0)
    sh = user32.GetSystemMetrics(1)
    if sw <= 0 or sh <= 0:
        return
    ax = int(screen_x * 65535 / sw)
    ay = int(screen_y * 65535 / sh)
    inputs = (INPUT * 3)()
    for i, flag in enumerate([MOUSEEVENTF_MOVE | MOUSEEVENTF_ABSOLUTE,
                               MOUSEEVENTF_LEFTDOWN | MOUSEEVENTF_ABSOLUTE,
                               MOUSEEVENTF_LEFTUP  | MOUSEEVENTF_ABSOLUTE]):
        inputs[i].type = INPUT_MOUSE
        inputs[i]._input.mi.dx = ax
        inputs[i]._input.mi.dy = ay
        inputs[i]._input.mi.dwFlags = flag
    user32.SendInput(3, inputs, ctypes.sizeof(INPUT))

def click_at_current_cursor(hwnd=None):
    """
    Clicks directly at the user's current mouse cursor position.
    """
    user32.mouse_event(MOUSEEVENTF_LEFTDOWN, 0, 0, 0, 0)
    time.sleep(0.005)
    user32.mouse_event(MOUSEEVENTF_LEFTUP, 0, 0, 0, 0)

    if hwnd and user32.IsWindow(hwnd):
        try:
            pt = ctypes.wintypes.POINT()
            user32.GetCursorPos(ctypes.byref(pt))
            user32.ScreenToClient(hwnd, ctypes.byref(pt))
            lparam = (pt.y << 16) | (pt.x & 0xFFFF)
            WM_LBUTTONDOWN = 0x0201
            WM_LBUTTONUP   = 0x0202
            user32.PostMessageW(hwnd, WM_LBUTTONDOWN, 1, lparam)
            time.sleep(0.005)
            user32.PostMessageW(hwnd, WM_LBUTTONUP, 0, lparam)
        except Exception:
            pass

def find_game_hwnd(pid=None):
    """Tìm đúng HWND cửa sổ chính của Play Together (loại trừ VSCode, Tool GUI, CMD, Terminal)."""
    excluded_keywords = ["visual studio", "vscode", "cmd.exe", "powershell", "python", ".py", "terminal", "kit tool"]

    def is_valid_game_hwnd(hwnd):
        if not hwnd or not user32.IsWindow(hwnd) or not user32.IsWindowVisible(hwnd):
            return False

        rect = ctypes.wintypes.RECT()
        user32.GetClientRect(hwnd, ctypes.byref(rect))
        w, h = rect.right - rect.left, rect.bottom - rect.top
        if w < 200 or h < 150:
            return False

        buf = ctypes.create_unicode_buffer(256)
        user32.GetWindowTextW(hwnd, buf, 256)
        title = buf.value.lower()

        # Loại bỏ các ứng dụng không phải game có chứa chữ "play" trong tiêu đề (như VSCode path)
        for keyword in excluded_keywords:
            if keyword in title:
                return False

        cls_buf = ctypes.create_unicode_buffer(256)
        user32.GetClassNameW(hwnd, cls_buf, 256)
        cls_name = cls_buf.value

        # Nếu có PID, ưu tiên match theo PID
        if pid:
            p = ctypes.wintypes.DWORD()
            user32.GetWindowThreadProcessId(hwnd, ctypes.byref(p))
            if p.value == pid:
                return True

        # Class của game Play Together trên Windows là UnityWndClass
        if cls_name == "UnityWndClass":
            return True

        # Tiêu đề game chuẩn
        if title in ["play together", "playtogether", "play together vng"]:
            return True

        return False

    # 1. Tìm trực tiếp theo Class UnityWndClass hoặc Title chuẩn
    for title in ["PLAY TOGETHER", "PlayTogether", "Play Together", "Play Together VNG"]:
        for cls in ["UnityWndClass", None]:
            h = user32.FindWindowW(cls, title)
            if h and is_valid_game_hwnd(h):
                return h

    # 2. EnumWindows quét tìm cửa sổ hợp lệ
    found = [0]
    def cb(hwnd, _):
        if is_valid_game_hwnd(hwnd):
            found[0] = hwnd
            return False
        return True

    WNDENUMPROC = ctypes.WINFUNCTYPE(ctypes.c_bool, ctypes.c_void_p, ctypes.c_void_p)
    user32.EnumWindows(WNDENUMPROC(cb), 0)
    return found[0]

def capture_hwnd_bgr(hwnd):
    if not hwnd or not user32.IsWindow(hwnd):
        return None
    rect = ctypes.wintypes.RECT()
    if not user32.GetClientRect(hwnd, ctypes.byref(rect)):
        return None
    w = rect.right - rect.left
    h = rect.bottom - rect.top
    if w <= 100 or h <= 100:
        return None

    arr = None
    try:
        hwnd_dc = user32.GetDC(hwnd)
        if hwnd_dc:
            mem_dc = gdi32.CreateCompatibleDC(hwnd_dc)
            bitmap = gdi32.CreateCompatibleBitmap(hwnd_dc, w, h)
            old_bitmap = gdi32.SelectObject(mem_dc, bitmap)

            PW_RENDERFULLCONTENT = 0x00000002
            PW_CLIENTONLY = 0x00000001
            res = user32.PrintWindow(hwnd, mem_dc, PW_CLIENTONLY | PW_RENDERFULLCONTENT)
            if not res:
                gdi32.BitBlt(mem_dc, 0, 0, w, h, hwnd_dc, 0, 0, 0x00CC0020)

            bmpinfo = BITMAPINFO()
            bmpinfo.bmiHeader.biSize = ctypes.sizeof(BITMAPINFOHEADER)
            bmpinfo.bmiHeader.biWidth = w
            bmpinfo.bmiHeader.biHeight = -h
            bmpinfo.bmiHeader.biPlanes = 1
            bmpinfo.bmiHeader.biBitCount = 32
            bmpinfo.bmiHeader.biCompression = 0

            buf = ctypes.create_string_buffer(w * h * 4)
            gdi32.GetDIBits(mem_dc, bitmap, 0, h, buf, ctypes.byref(bmpinfo), 0)

            gdi32.SelectObject(mem_dc, old_bitmap)
            gdi32.DeleteObject(bitmap)
            gdi32.DeleteDC(mem_dc)
            user32.ReleaseDC(hwnd, hwnd_dc)

            arr = np.frombuffer(buf, dtype=np.uint8).reshape((h, w, 4))
    except Exception:
        arr = None

    if arr is not None and np.max(arr) > 0:
        return cv2.cvtColor(arr, cv2.COLOR_BGRA2BGR)

    try:
        from PIL import ImageGrab
        pt = ctypes.wintypes.POINT(0, 0)
        user32.ClientToScreen(hwnd, ctypes.byref(pt))
        bbox = (pt.x, pt.y, pt.x + w, pt.y + h)
        img = ImageGrab.grab(bbox=bbox)
        return cv2.cvtColor(np.array(img), cv2.COLOR_RGB2BGR)
    except Exception:
        pass

    return None

def check_fight_banner(bgr):
    if bgr is None or bgr.size == 0:
        return False
    h, w = bgr.shape[:2]
    # Center ROI where FIGHT! explosion appears (Y: 15% to 85%, X: 10% to 90%)
    roi = bgr[int(h * 0.15):int(h * 0.85), int(w * 0.10):int(w * 0.90)]
    if roi.size == 0:
        return False

    rh, rw = roi.shape[:2]
    total_pix = rh * rw
    hsv = cv2.cvtColor(roi, cv2.COLOR_BGR2HSV)

    # 1. Vibrant Yellow of FIGHT text (H: 18-36, S: 150-255, V: 150-255)
    mask_yellow = cv2.inRange(hsv, np.array([18, 150, 150]), np.array([36, 255, 255]))

    # 2. Vibrant Red of Comic Burst (H: 0-12 or 168-180, S: 150-255, V: 130-255)
    mask_r1 = cv2.inRange(hsv, np.array([0, 150, 130]), np.array([12, 255, 255]))
    mask_r2 = cv2.inRange(hsv, np.array([168, 150, 130]), np.array([180, 255, 255]))
    mask_red = cv2.bitwise_or(mask_r1, mask_r2)

    yellow_pix = cv2.countNonZero(mask_yellow)
    red_pix = cv2.countNonZero(mask_red)

    yellow_ratio = yellow_pix / total_pix
    red_ratio = red_pix / total_pix

    # Genuine FIGHT! banner - lower thresholds to catch the very first animation frame
    # (yellow ≥ 4% of ROI, red ≥ 2%)
    if yellow_ratio < 0.04 or red_ratio < 0.02:
        return False

    # 3. Geometric contour verification (ensure yellow pixels form letters F, I, G, H, T, !)
    contours, _ = cv2.findContours(mask_yellow, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    min_letter_area = total_pix * 0.004  # each letter is at least 0.4% of ROI
    letter_blobs = 0

    for c in contours:
        area = cv2.contourArea(c)
        if area >= min_letter_area:
            bx, by, bw, bh = cv2.boundingRect(c)
            # Upright letter proportions
            if bh > rh * 0.12 and 0.15 < (bw / float(bh)) < 4.0:
                letter_blobs += 1

    return (letter_blobs >= 2)

