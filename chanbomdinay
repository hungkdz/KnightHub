                "icon": "🎭",
                "name": "Anime Mascot",
                "extra": "Overlay",
                "color": QColor(236, 72, 153)
            })

        return items

    def _sync_with_game(self):
        is_enabled = getattr(self.parent_app, 'show_hud_features', False)
        hwnd_game = self._get_game_hwnd()

        if not is_enabled or not hwnd_game or not user32.IsWindowVisible(hwnd_game):
            if self._is_child_mode:
                self._detach_from_game()
            if self.isVisible():
                self.hide()
            return

        if user32.IsIconic(hwnd_game):
            if self._is_child_mode:
                self._detach_from_game()
            if self.isVisible():
                self.hide()
            return

        if self._injected_into != hwnd_game or not self._is_child_mode:
            if self._is_child_mode:
                self._detach_from_game()
            self._inject_into_game(hwnd_game)

        active_features = self._get_active_features()
        active_keys = {f["key"] for f in active_features}

        # Đánh dấu các tính năng vừa bị tắt để kích hoạt animation trượt ra viền
        for it in self._items:
            if it.key not in active_keys:
                it.is_exiting = True

        # Cập nhật hoặc thêm tính năng mới với animation morph từ viền vào
        existing_map = {it.key: it for it in self._items}
        for feat in active_features:
            k = feat["key"]
            if k in existing_map:
                existing = existing_map[k]
                existing.extra = feat["extra"]
                existing.is_exiting = False
            else:
                new_item = FeatureItemAnim(feat["key"], feat["icon"], feat["name"], feat["extra"], feat["color"])
                self._items.append(new_item)

        # Cập nhật vị trí Y đích cho từng thẻ đang hiển thị
        visible_items = [it for it in self._items if not it.is_exiting]
        for idx, it in enumerate(visible_items):
            it.target_y = self._header_h + 8 + idx * (self._card_h + self._spacing)

        if not self._items and self._header_progress <= 0.0:
            if self.isVisible():
                self.hide()
            return

        # Tính toán kích thước Logical với lề dưới dư dả (tuyệt đối không bị cắt xén)
        vis_count = max(1, len(visible_items))
        needed_w = self._total_w
        needed_h = self._header_h + 12 + vis_count * (self._card_h + self._spacing) + 16

        # Chuyển đổi High-DPI sang Physical Pixels cho Win32 API
        dpr = self.devicePixelRatioF() or 1.0
        phys_w = int(round(needed_w * dpr))
        phys_h = int(round(needed_h * dpr))

        rx = 0  # Bám sát mép trái game để animation morph trượt từ viền game vào mượt mà
        ry = self._calc_top_y(hwnd_game)
        phys_x = int(round(rx * dpr))
        phys_y = int(round(ry * dpr))

        if not self.isVisible():
            self.show()

        hwnd_ov = int(self.winId())
        if hwnd_ov and user32.IsWindow(hwnd_ov):
            if not user32.IsWindowVisible(hwnd_ov):
                user32.ShowWindow(hwnd_ov, 8)  # SW_SHOWNA

            SetWindowPos_fn(
                hwnd_ov, HWND_TOP,
                phys_x, phys_y,
                phys_w, phys_h,
                SWP_NOACTIVATE | SWP_SHOWWINDOW
            )
            self.resize(needed_w, needed_h)

    def paintEvent(self, event):
        if not self._items and self._header_progress <= 0.0:
            return

        painter = QPainter(self)
        painter.setRenderHint(QPainter.Antialiasing)
        painter.setRenderHint(QPainter.TextAntialiasing)

        visible_items = [it for it in self._items if not it.is_exiting]

        # ── 1. HEADER (Có hiệu ứng morph từ viền vào) ───────────────────
        if self._header_progress > 0.01:
            hdr_ease = _ease_out_cubic(self._header_progress)
            hdr_alpha = max(0.0, min(1.0, self._header_progress * 1.4))
            hdr_x = self._base_x + (1.0 - hdr_ease) * (-self._base_x - self._base_card_w)

            header_rect = QRectF(hdr_x, 0, self._base_card_w, self._header_h)
            painter.setPen(Qt.NoPen)
            painter.setBrush(QColor(12, 14, 24, int(220 * hdr_alpha)))
            painter.drawRoundedRect(header_rect, 6, 6)

            # Chấm tròn phát sáng
            painter.setBrush(QColor(0, 245, 212, int(255 * hdr_alpha)))
            painter.drawEllipse(QPointF(hdr_x + 14, 14), 3.5, 3.5)

            # Chữ tiêu đề (khoảng trống 160px rộng rãi, không đè lên chip đếm)
            font_hdr = QFont("Segoe UI", 9, QFont.Bold)
            painter.setFont(font_hdr)
            painter.setPen(QColor(0, 245, 212, int(255 * hdr_alpha)))
            painter.drawText(QRectF(hdr_x + 25, 0, 160, self._header_h), Qt.AlignVCenter | Qt.AlignLeft, "TÍNH NĂNG ĐANG BẬT")

            # Chip đếm số lượng tính năng tách biệt bên phải
            chip_w = 54
            chip_rect = QRectF(hdr_x + self._base_card_w - chip_w - 6, 5, chip_w, 18)
            painter.setPen(Qt.NoPen)
            painter.setBrush(QColor(0, 245, 212, int(35 * hdr_alpha)))
            painter.drawRoundedRect(chip_rect, 4, 4)

            font_badge = QFont("Consolas", 9, QFont.Bold)
            painter.setFont(font_badge)
            painter.setPen(QColor(0, 245, 212, int(255 * hdr_alpha)))
            painter.drawText(chip_rect, Qt.AlignCenter, f"[ {len(visible_items)} ]")

        # ── 2. CÁC THẺ TÍNH NĂNG (HIỆU ỨNG MORPH TRƯỢT TỪ VIỀN GAME VÀO) ────
        for it in self._items:
            if it.progress <= 0.001:
                continue

            if it.is_exiting:
                ease = _ease_out_cubic(it.progress)
            else:
                ease = _ease_out_back(it.progress)

            # Chạy từ viền mép game vào vị trí cố định
            card_x = self._base_x + (1.0 - ease) * (-self._base_x - self._base_card_w)
            alpha = max(0.0, min(1.0, it.progress * 1.4))

            # Morph dãn chiều rộng từ viền ra kích thước chuẩn
            w_morph = self._base_card_w * (0.35 + 0.65 * min(1.0, max(0.0, ease)))
            cy = it.current_y

            card_rect = QRectF(card_x, cy, w_morph, self._card_h)

            # Nền dark glassmorphism
            painter.setPen(Qt.NoPen)
            painter.setBrush(QColor(15, 18, 30, int(220 * alpha)))
            painter.drawRoundedRect(card_rect, 6, 6)

            # Dải vệt sáng viền trái (glowing morph accent)
            strip_rect = QRectF(card_x, cy, 3.5, self._card_h)
            painter.setBrush(QColor(it.color.red(), it.color.green(), it.color.blue(), int(255 * alpha)))
            painter.drawRoundedRect(strip_rect, 2, 2)

            # Viền phát sáng xung quanh
            pen_border = QPen(QColor(it.color.red(), it.color.green(), it.color.blue(), int(80 * alpha)))
            pen_border.setWidthF(1.0)
            painter.setPen(pen_border)
            painter.setBrush(Qt.NoBrush)
            painter.drawRoundedRect(card_rect, 6, 6)

            # Biểu tượng Icon
            font_icon = QFont("Segoe UI Emoji", 11)
            painter.setFont(font_icon)
            painter.setPen(QColor(255, 255, 255, int(255 * alpha)))
            painter.drawText(QRectF(card_x + 8, cy, 24, self._card_h), Qt.AlignCenter, it.icon)

            # Tên tính năng (chiều rộng 142px thoải mái, không bao giờ bị cắt)
            font_name = QFont("Segoe UI", 9, QFont.DemiBold)
            painter.setFont(font_name)
            painter.setPen(QColor(240, 242, 252, int(255 * alpha)))
            painter.drawText(QRectF(card_x + 36, cy, 142, self._card_h), Qt.AlignVCenter | Qt.AlignLeft, it.name)

            # Badge thông số trạng thái bên phải
            extra_str = it.extra if it.extra else "ON"
            font_tag = QFont("Consolas", 8, QFont.Bold)
            painter.setFont(font_tag)
            tag_w = max(42, int(painter.fontMetrics().horizontalAdvance(extra_str) + 14))
            tag_rect = QRectF(card_x + w_morph - tag_w - 6, cy + 7, tag_w, self._card_h - 14)

            painter.setPen(Qt.NoPen)
            painter.setBrush(QColor(it.color.red(), it.color.green(), it.color.blue(), int(45 * alpha)))
            painter.drawRoundedRect(tag_rect, 4, 4)

            painter.setPen(QColor(it.color.red(), it.color.green(), it.color.blue(), int(255 * alpha)))
            painter.drawText(tag_rect, Qt.AlignCenter, extra_str)

    def stop(self):
        self._anim_timer.stop()
        self._sync_timer.stop()
        if self._is_child_mode:
            self._detach_from_game()
        self.hide()


