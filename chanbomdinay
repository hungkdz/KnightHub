                "icon": "✈️",
                "name": "Chế độ bay",
                "extra": extra,
                "color": QColor(0, 245, 212)
            })

        # 2. Noclip (Xuyên tường)
        if getattr(app, 'noclip_with_fly', False) and getattr(app, 'fly_active', False):
            items.append({
                "key": "noclip",
                "icon": "🧱",
                "name": "Noclip Xuyên tường",
                "extra": "Active",
                "color": QColor(167, 139, 250)
            })
        elif getattr(app, 'noclip_with_fly', False) and hasattr(app, 'chk_noclip') and app.chk_noclip.isChecked():
            items.append({
                "key": "noclip",
                "icon": "🧱",
                "name": "Noclip Xuyên tường",
                "extra": "Bật",
                "color": QColor(167, 139, 250)
            })

        # 3. Auto Đập Búa
        if getattr(app, 'auto_hammer_active', False):
            items.append({
                "key": "hammer",
                "icon": "🔨",
                "name": "Auto Đập Búa",
                "extra": "FIGHT!",
                "color": QColor(251, 191, 36)
            })

        # 4. Multi Jump
        if getattr(app, 'enable_multi_jump', False):
            h = getattr(app, 'multi_jump_height', 8.0)
            items.append({
                "key": "multi_jump",
                "icon": "🦘",
                "name": "Multi Jump",
                "extra": f"{h:.0f}m",
                "color": QColor(56, 189, 248)
            })

        # 5. Jump Boost
        if getattr(app, 'enable_jump_boost', False):
            m = getattr(app, 'jump_boost_multiplier', 2.0)
            items.append({
                "key": "jump_boost",
                "icon": "⚡",
                "name": "Jump Boost",
                "extra": f"{m:.1f}x",
                "color": QColor(244, 63, 94)
            })

        # 6. Long Jump
        if getattr(app, 'enable_long_jump', False):
