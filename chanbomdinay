class SwitchToggle(QCheckBox):
    """Công tắc iOS hiện đại với hitbox mở rộng, siêu nhạy và mượt mà."""
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setCursor(Qt.PointingHandCursor)
        self.setFixedSize(50, 26)
        self._is_hovered = False

    def enterEvent(self, event):
        self._is_hovered = True
        self.update()
        super().enterEvent(event)

    def leaveEvent(self, event):
        self._is_hovered = False
        self.update()
        super().leaveEvent(event)

    def hitButton(self, pos: QPoint) -> bool:
        # Mở rộng vùng nhận diện click thêm 10px chiều ngang và 8px chiều dọc
        return self.rect().adjusted(-10, -8, 10, 8).contains(pos)

    def mouseReleaseEvent(self, event):
        if event.button() == Qt.LeftButton:
            # Nhấp ở bất cứ đâu trong phạm vi mở rộng quanh nút là toggle ngay lập tức
            if self.rect().adjusted(-12, -8, 12, 8).contains(event.position().toPoint()):
                self.setChecked(not self.isChecked())
                event.accept()
                return
        super().mouseReleaseEvent(event)

    def paintEvent(self, _event):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)

        checked = self.isChecked()
        if checked:
            track_color = QColor("#ff5c7c") if self._is_hovered else QColor("#ff4769")
            thumb_x = 26
        else:
            track_color = QColor("#35354e") if self._is_hovered else QColor("#262638")
            thumb_x = 3

        # Vẽ rãnh trượt bo tròn mềm mại
        p.setPen(QPen(QColor("#ff4769" if checked else "#3d3d56"), 1))
        p.setBrush(QBrush(track_color))
        p.drawRoundedRect(0, 0, 50, 26, 13, 13)

        # Vẽ nút tròn trắng
        p.setPen(Qt.NoPen)
        p.setBrush(QBrush(QColor("#ffffff")))
        p.drawEllipse(thumb_x, 3, 20, 20)
        p.end()


class ClickableLabel(QLabel):
    """Nhãn có thể click để bật/tắt công tắc tương ứng, giúp tương tác cực nhạy."""
    def __init__(self, text="", toggle=None, parent=None):
        super().__init__(text, parent)
        self.toggle = toggle
        self.setCursor(Qt.PointingHandCursor)

    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton and self.toggle:
            self.toggle.setChecked(not self.toggle.isChecked())
            event.accept()
            return
        super().mousePressEvent(event)


