    def do_multi_jump(self):
        """Thực hiện cú nhảy ngay lập tức như nhảy bình thường, nhảy được ngay từ khi chưa chạm đất."""
        if not self.connected:
            return
        now = time.time()
        if now - self._last_multi_jump_time < 0.10:   # cooldown 100ms
            return
        self._last_multi_jump_time = now

        try:
            lp   = self.local_player_addr
            ctrl = self.actor_control_addr or (self._read_ptr(lp + 0x1B8) if lp else 0) or (self._read_ptr(lp + 0x1D8) if lp else 0)
            kin  = self.kinematic_addr or (self._read_ptr(ctrl + 0x3D0) if ctrl else 0) or (self._read_ptr(ctrl + 0xA0) if ctrl else 0) or (self._read_ptr(ctrl + 0x3B0) if ctrl else 0)
            motor = self.motor_addr or (self._read_ptr(kin + 0x20) if kin else 0)

            if kin and (0x10000 < kin < 0x7FFFFFFFFFFF):
                spd = self._get_effective_jump_speed()
                self._write_float(kin + 0x9C, spd)            # _stableJumpSpeed
                self._write_float(kin + 0x58, 0.0)             # _buffJumpSpeed
                self._write_mem(kin + 0xA8, struct.pack('B', 0)) # _useExtraJump = 0

                # Cho phép nhảy trên không (air jump)
                self._write_mem(kin + 0x99, struct.pack('B', 1))   # allowDoubleJump = 1
                self._write_mem(kin + 0xF8, struct.pack('B', 0))   # doubleJumpConsumed = 0
                self._write_float(kin + 0xF4, 0.0)                 # timeSinceLastAbleToJump = 0.0

                # Khi đang lơ lửng, đảm bảo jumpConsumed = 1 để nhánh air jump của game hoạt động
                if motor and (0x10000 < motor < 0x7FFFFFFFFFFF):
                    raw_g = self._read_mem(motor + 0x89, 1)
                    is_grounded = bool(raw_g[0]) if raw_g else False
                    if not is_grounded:
                        self._write_mem(kin + 0xED, struct.pack('B', 1)) # jumpConsumed = 1

                # Yêu cầu game thực hiện cú nhảy native
                self._write_mem(kin + 0xEC, struct.pack('B', 1))   # jumpRequested = 1
                self._write_float(kin + 0xF0, 0.0)                 # timeSinceJumpRequested = 0.0
        except Exception as e:
            print(f"[-] Lỗi Multi Jump: {e}")

