            if not self.selected_target_player_ptr:
                QMessageBox.information(self, "Thông báo", "Vui lòng chọn một người chơi để theo dõi!")
                if hasattr(self, 'sw_follow_player'):
                    self.sw_follow_player.setChecked(False)
                self.follow_player_active = False
                return
            if self.enable_sound_beep:
                try: winsound.Beep(1500, 80)
                except Exception: pass
        else:
            if self.enable_sound_beep:
                try: winsound.Beep(800, 80)
                except Exception: pass

    def teleport_to(self, tx: float, ty: float, tz: float):
        if not self.connected:
            QMessageBox.warning(self, "Cảnh báo", "Chưa kết nối tới game Play Together!")
            return False

        def _do_teleport():
            try:
                motor = self.motor_addr
                ctrl = self.actor_control_addr
                player = self.local_player_addr

                if self.fly_active:
                    # --- CHẾ ĐỘ BAY: Dịch chuyển trên không ---
                    target_y = float(ty) + 0.5
                    self.fly_target_y = target_y

                    if motor and (0x10000 < motor < 0x7FFFFFFFFFFF):
                        self._write_mem(motor + 0x290, struct.pack('B', 0))  # _solveMovementCollisions = 0 (Noclip)

                        self._write_float(motor + 0x100, tx)
                        self._write_float(motor + 0x104, target_y)
                        self._write_float(motor + 0x108, tz)

                        self._write_float(motor + 0x160, tx)
                        self._write_float(motor + 0x164, target_y)
                        self._write_float(motor + 0x168, tz)

                        self._write_float(motor + 0x210, tx)
                        self._write_float(motor + 0x214, target_y)
                        self._write_float(motor + 0x218, tz)

                        self._write_float(motor + 0x294, tx)
                        self._write_float(motor + 0x298, target_y)
                        self._write_float(motor + 0x29c, tz)

                        self._write_float(motor + 0x110, 0.0)
                        self._write_float(motor + 0x114, 0.0)
                        self._write_float(motor + 0x118, 0.0)
                        self._write_float(motor + 0x25c, 0.0)

                        self._write_mem(motor + 0x291, struct.pack('B', 1))
                        self._write_mem(motor + 0x292, struct.pack('B', 1))
                        self._write_mem(motor + 0x2cd, struct.pack('B', 1))  # _mustUnground = 1
                        self._write_float(motor + 0x2d0, 1.0)               # _mustUngroundTimeCounter = 1.0

                    if ctrl and (0x10000 < ctrl < 0x7FFFFFFFFFFF):
                        self._write_float(ctrl + 0x120, tx)
                        self._write_float(ctrl + 0x124, target_y)
                        self._write_float(ctrl + 0x128, tz)

                        sync_ptr = self._read_ptr(ctrl + 0x110)
                        if sync_ptr and (0x10000 < sync_ptr < 0x7FFFFFFFFFFF):
                            self._write_float(sync_ptr + 0x18, tx)
                            self._write_float(sync_ptr + 0x1c, target_y)
                            self._write_float(sync_ptr + 0x20, tz)

                    if player and (0x10000 < player < 0x7FFFFFFFFFFF):
                        self._write_float(player + 0x58, tx)
                        self._write_float(player + 0x5c, target_y)
                        self._write_float(player + 0x60, tz)

                    self.pos_x, self.pos_y, self.pos_z = tx, target_y, tz
                else:
                    # --- CHẾ ĐỘ THƯỜNG (GROUND): Dịch chuyển tiếp đất chuẩn xác, không sụt đất ---
                    target_y = float(ty) + 0.15  # Nâng 0.15m sát mặt đất của người chơi mục tiêu

                    # 1. Tạm tắt va chạm trong khoảnh khắc dịch chuyển để nhảy qua tường/vật cản giữa đường
                    if motor and (0x10000 < motor < 0x7FFFFFFFFFFF):
                        self._write_mem(motor + 0x290, struct.pack('B', 0))

                    # 2. Ghi vị trí và khóa cờ Tiếp đất (Grounded) không cho trọng lực kéo xuống dưới đất
                    for _ in range(3):
                        if motor and (0x10000 < motor < 0x7FFFFFFFFFFF):
                            self._write_float(motor + 0x100, tx)
                            self._write_float(motor + 0x104, target_y)
                            self._write_float(motor + 0x108, tz)

                            self._write_float(motor + 0x160, tx)
                            self._write_float(motor + 0x164, target_y)
                            self._write_float(motor + 0x168, tz)

                            self._write_float(motor + 0x210, tx)
                            self._write_float(motor + 0x214, target_y)
                            self._write_float(motor + 0x218, tz)

                            self._write_float(motor + 0x294, tx)
                            self._write_float(motor + 0x298, target_y)
                            self._write_float(motor + 0x29c, tz)

                            self._write_float(motor + 0x110, 0.0)
                            self._write_float(motor + 0x114, 0.0)
                            self._write_float(motor + 0x118, 0.0)
                            self._write_float(motor + 0x25c, 0.0)

                            # Đặt trạng thái tiếp đất vững chắc (Grounded)
                            self._write_mem(motor + 0x240, struct.pack('B', 1))  # IsStableOnGround = 1
                            self._write_mem(motor + 0x241, struct.pack('B', 1))  # FoundAnyGround = 1
                            self._write_float(motor + 0x248, 1.0)               # GroundNormal.Y = 1.0
                            self._write_mem(motor + 0x291, struct.pack('B', 1))  # IsWarping = 1
                            self._write_mem(motor + 0x292, struct.pack('B', 1))  # movePositionDirty = 1
                            self._write_mem(motor + 0x2cd, struct.pack('B', 0))  # _mustUnground = 0 (GROUNDED!)
                            self._write_float(motor + 0x2d0, 0.0)               # _mustUngroundTimeCounter = 0

                        if ctrl and (0x10000 < ctrl < 0x7FFFFFFFFFFF):
                            self._write_float(ctrl + 0x120, tx)
                            self._write_float(ctrl + 0x124, target_y)
                            self._write_float(ctrl + 0x128, tz)

                            sync_ptr = self._read_ptr(ctrl + 0x110)
                            if sync_ptr and (0x10000 < sync_ptr < 0x7FFFFFFFFFFF):
                                self._write_float(sync_ptr + 0x18, tx)
                                self._write_float(sync_ptr + 0x1c, target_y)
                                self._write_float(sync_ptr + 0x20, tz)

                        if player and (0x10000 < player < 0x7FFFFFFFFFFF):
                            self._write_float(player + 0x58, tx)
                            self._write_float(player + 0x5c, target_y)
                            self._write_float(player + 0x60, tz)

                        time.sleep(0.015)

                    # 3. Mở lại va chạm vật lý ngay lập tức để nhân vật đứng vững trên sàn
                    if motor and (0x10000 < motor < 0x7FFFFFFFFFFF):
                        self._write_mem(motor + 0x290, struct.pack('B', 1))

                    self.fly_target_y = target_y
                    self.pos_x, self.pos_y, self.pos_z = tx, target_y, tz

                if self.enable_sound_beep:
                    try: winsound.Beep(1400, 80)
                    except Exception: pass

                return True
            except Exception as e:
                print(f"[-] Lỗi dịch chuyển: {e}")
                return False

        threading.Thread(target=_do_teleport, daemon=True).start()
        return True

    def _follow_player_loop(self):
        while self.running:
            if not self.follow_player_active or not self.selected_target_player_ptr or not self.connected:
                time.sleep(0.1)
                continue

            try:
                target_ptr = self.selected_target_player_ptr
                if not (0x10000 < target_ptr < 0x7FFFFFFFFFFF):
                    time.sleep(0.1)
                    continue

                tx = self._read_float(target_ptr + 0x58)
                ty = self._read_float(target_ptr + 0x5c)
                tz = self._read_float(target_ptr + 0x60)

                if (tx == 0.0 and ty == 0.0 and tz == 0.0) or abs(tx) > 20000:
                    for ctrl_off in [0x1D8, 0x68, 0x70, 0x58, 0x1B8]:
                        ctrl = self._read_ptr(target_ptr + ctrl_off)
                        if ctrl and 0x10000 < ctrl < 0x7FFFFFFFFFFF:
                            tax = self._read_float(ctrl + 0x120) or self._read_float(ctrl + 0xFC)
                            tay = self._read_float(ctrl + 0x124) or self._read_float(ctrl + 0x100)
                            taz = self._read_float(ctrl + 0x128) or self._read_float(ctrl + 0x104)
                            if not (tax == 0.0 and tay == 0.0 and taz == 0.0):
                                tx, ty, tz = tax, tay, taz
                                break

                if not (tx == 0.0 and ty == 0.0 and tz == 0.0) and abs(tx) < 20000:
                    dist = math.sqrt((tx - self.pos_x)**2 + (ty - self.pos_y)**2 + (tz - self.pos_z)**2)
                    if dist > 0.4:
                        motor = self.motor_addr
                        ctrl = self.actor_control_addr
                        target_y = ty + 0.1

                        if motor and (0x10000 < motor < 0x7FFFFFFFFFFF):
                            self._write_float(motor + 0x100, tx)
                            self._write_float(motor + 0x104, target_y)
                            self._write_float(motor + 0x108, tz)
                            self._write_float(motor + 0x294, tx)
                            self._write_float(motor + 0x298, target_y)
                            self._write_float(motor + 0x29c, tz)
                            self._write_mem(motor + 0x292, struct.pack('B', 1))
                            self._write_mem(motor + 0x2cd, struct.pack('B', 1))
                            self._write_float(motor + 0x2d0, 1.0)
                            self._write_mem(motor + 0x290, struct.pack('B', 0))

                        if ctrl and (0x10000 < ctrl < 0x7FFFFFFFFFFF):
                            self._write_float(ctrl + 0x120, tx)
                            self._write_float(ctrl + 0x124, target_y)
                            self._write_float(ctrl + 0x128, tz)

                        if self.local_player_addr:
                            self._write_float(self.local_player_addr + 0x58, tx)
                            self._write_float(self.local_player_addr + 0x5c, target_y)
                            self._write_float(self.local_player_addr + 0x60, tz)

                        self.pos_x, self.pos_y, self.pos_z = tx, target_y, tz

                time.sleep(0.04)
            except Exception:
                time.sleep(0.1)

    def _scan_nearby_players(self):
        if not self.connected or not self.ga_base:
            return []
        
        try:
            actor_rva = self._get_actor_system_rva()
            actor_sys_class = self._read_ptr(self.ga_base + actor_rva)
            static_fields = self._read_ptr(actor_sys_class + 0xB8) if actor_sys_class else 0
            actor_sys_self = self._read_ptr(static_fields + 0x00) if static_fields else 0
            local_player = self.local_player_addr or (self._read_ptr(actor_sys_self + 0x58) if actor_sys_self else 0)
            
            if not actor_sys_self or not (0x10000 < actor_sys_self < 0x7FFFFFFFFFFF):
                return []
            
            px, py, pz = self.pos_x, self.pos_y, self.pos_z
            seen = set()
            players = []

            def inspect_actor(ptr):
                if not ptr or ptr in seen or not (0x10000 < ptr < 0x7FFFFFFFFFFF):
                    return
                if ptr == local_player:
                    return

                klass = self._read_ptr(ptr)
                if not klass or not (0x10000 < klass < 0x7FFFFFFFFFFF):
                    return
                name_ptr = self._read_ptr(klass + 0x10)
                if not name_ptr or not (0x10000 < name_ptr < 0x7FFFFFFFFFFF):
                    return
                cname = self._read_str(name_ptr, 32)
                if not cname:
                    return

                seen.add(ptr)

                if cname not in ('ActorCharacter', 'ActorOtherPlayer', 'ActorPlayer'):
                    return

                ax, ay, az = 0.0, 0.0, 0.0
                pos_found = False

                tx = self._read_float(ptr + 0x58)
                ty = self._read_float(ptr + 0x5c)
                tz = self._read_float(ptr + 0x60)
                if not (tx == 0.0 and ty == 0.0 and tz == 0.0) and abs(tx) < 20000 and abs(tz) < 20000:
                    ax, ay, az = tx, ty, tz
                    pos_found = True
                else:
                    for ctrl_off in [0x1D8, 0x68, 0x70, 0x58, 0x1B8]:
                        ctrl = self._read_ptr(ptr + ctrl_off)
                        if ctrl and 0x10000 < ctrl < 0x7FFFFFFFFFFF:
                            tax = self._read_float(ctrl + 0x120) or self._read_float(ctrl + 0xFC)
                            tay = self._read_float(ctrl + 0x124) or self._read_float(ctrl + 0x100)
                            taz = self._read_float(ctrl + 0x128) or self._read_float(ctrl + 0x104)
                            if not (tax == 0.0 and tay == 0.0 and taz == 0.0) and abs(tax) < 20000 and abs(taz) < 20000:
                                ax, ay, az = tax, tay, taz
                                pos_found = True
                                break

                if not pos_found:
                    return

                dist = math.sqrt((ax - px)**2 + (ay - py)**2 + (az - pz)**2)
                nick = self._read_player_nickname(ptr)
                if not nick:
                    ptr_hex = hex(ptr)[-4:].upper()
                    nick = f"Player_{ptr_hex}"

                players.append({
                    'name': nick,
                    'dist': dist,
                    'x': ax,
                    'y': ay,
                    'z': az,
                    'ptr': ptr
                })

            for dict_off in range(0x10, 0x400, 8):
                dict_ptr = self._read_ptr(actor_sys_self + dict_off)
                if not dict_ptr or not (0x10000 < dict_ptr < 0x7FFFFFFFFFFF):
                    continue
                entries_arr = self._read_ptr(dict_ptr + 0x18)
                if not entries_arr or not (0x10000 < entries_arr < 0x7FFFFFFFFFFF):
                    continue
                arr_len_d = self._read_mem(entries_arr + 0x18, 4)
                if not arr_len_d: continue
                arr_len = struct.unpack('<i', arr_len_d)[0]
                if arr_len <= 0 or arr_len > 4000: continue

                for entry_size in [24, 32, 40]:
                    raw = self._read_mem(entries_arr + 0x20, min(arr_len, 250) * entry_size)
                    if not raw: continue
                    for i in range(min(arr_len, 250)):
                        e_addr = entries_arr + 0x20 + (i * entry_size)
                        for item_off in [8, 16]:
                            p = self._read_ptr(e_addr + item_off)
                            inspect_actor(p)

            for list_off in [0x050, 0x170, 0x178, 0x188, 0x190]:
                l_ptr = self._read_ptr(actor_sys_self + list_off)
                if not l_ptr or not (0x10000 < l_ptr < 0x7FFFFFFFFFFF): continue
                items_arr = self._read_ptr(l_ptr + 0x10)
                sz_d = self._read_mem(l_ptr + 0x18, 4)
                if items_arr and (0x10000 < items_arr < 0x7FFFFFFFFFFF) and sz_d:
                    sz = struct.unpack('<i', sz_d)[0]
                    if 0 < sz < 3000:
                        raw = self._read_mem(items_arr + 0x20, min(sz, 250) * 8)
                        if raw:
                            for i in range(min(sz, 250)):
                                p = struct.unpack_from('<Q', raw, i * 8)[0]
                                inspect_actor(p)

            players.sort(key=lambda p: p['dist'])
            return players
        except Exception:
            return []

    def _read_il2cpp_str(self, addr):
        if not addr or not (0x10000 < addr < 0x7FFFFFFFFFFF):
            return ""
        try:
            len_d = self._read_mem(addr + 0x10, 4)
            if not len_d: return ""
            slen = struct.unpack('<i', len_d)[0]
            if slen <= 0 or slen > 128: return ""
            chars = self._read_mem(addr + 0x14, slen * 2)
            if not chars: return ""
            s = chars.decode('utf-16-le', errors='replace').strip()
            return s if s.isprintable() else ""
        except Exception:
            return ""

    def _read_str(self, addr, max_len=64):
        if not addr or not (0x10000 < addr < 0x7FFFFFFFFFFF):
            return ""
        try:
            d = self._read_mem(addr, max_len)
            if not d: return ""
            nul = d.find(b'\x00')
            if nul != -1: d = d[:nul]
            s = d.decode('utf-8', errors='replace').strip()
            return s if s.isprintable() else ""
        except Exception:
            return ""

    def _read_player_nickname(self, player_ptr) -> str:
        if not player_ptr or not (0x10000 < player_ptr < 0x7FFFFFFFFFFF):
            return ""
        try:
            for nick_off in [0x1D0, 0x1F0, 0x200, 0x208, 0x210, 0x218, 0x1E0, 0x1E8, 0x1C8, 0x30, 0x28]:
                vp = self._read_ptr(player_ptr + nick_off)
                if not (vp and 0x10000 < vp < 0x7FFFFFFFFFFF):
                    continue
                len_d = self._read_mem(vp + 0x10, 4)
                if not len_d:
                    continue
                slen = struct.unpack('<i', len_d)[0]
                if slen <= 0 or slen > 64:
                    continue
                chars_d = self._read_mem(vp + 0x14, slen * 2)
                if not chars_d:
                    continue
                try:
                    s = chars_d.decode('utf-16-le', errors='replace').strip()
                    if s and s.isprintable() and not s.startswith('0x') and not s.startswith('{'):
                        return s
                except Exception:
                    pass
        except Exception:
            pass
        return ""

