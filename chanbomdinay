    def _on_sw_fly_toggled(self, checked):
        if checked != self.fly_active:
            self.toggle_fly_mode()

    def _on_sw_hammer_toggled(self, checked):
        if checked != self.auto_hammer_active:
            self.toggle_auto_hammer()

    def _on_topmost_toggled(self, checked):
        self.always_on_top = checked
        if hasattr(self, 'title_bar'):
            self.title_bar.btn_pin.setChecked(checked)
        self._update_topmost()
        self.save_config()

    def _on_hud_features_toggled(self, checked):
        self.show_hud_features = checked
        if hasattr(self, 'hud_features_overlay') and self.hud_features_overlay:
            if checked:
                self.hud_features_overlay._sync_with_game()
            else:
                self.hud_features_overlay.hide()
                if self.hud_features_overlay._is_child_mode:
                    self.hud_features_overlay._detach_from_game()
        if self.enable_sound_beep:
            try: winsound.Beep(1200 if checked else 700, 50)
            except Exception: pass
        self.save_config()

    def _toggle_pin(self):
        self.always_on_top = self.title_bar.btn_pin.isChecked()
        if hasattr(self, 'chk_topmost'):
            self.chk_topmost.setChecked(self.always_on_top)
        self._update_topmost()
        self.save_config()

    def _update_topmost(self):
        flags = Qt.FramelessWindowHint | Qt.Window
        if self.always_on_top:
            flags |= Qt.WindowStaysOnTopHint
        self.setWindowFlags(flags)
        self.show()

    def _on_anime_overlay_toggled(self, checked):
        self.anime_overlay_enabled = checked
        self.mascot_overlay_enabled = checked
        if hasattr(self, 'mascot_overlay'):
            if checked:
                vp = getattr(self, 'anime_video_path', '')
                if vp and os.path.exists(vp):
                    if not self.mascot_overlay._pixmap_cache and not self.mascot_overlay._loading:
                        self.mascot_overlay.reload_media(vp)
                    else:
                        if not self.mascot_overlay._frame_timer.isActive() and self.mascot_overlay._pixmap_cache:
                            dur0 = self.mascot_overlay._durations_ms[0] if self.mascot_overlay._durations_ms else 42
                            self.mascot_overlay._frame_timer.start(dur0)
                        self.mascot_overlay._sync_with_game()
                else:
                    self.mascot_overlay._sync_with_game()
            else:
                self.mascot_overlay._frame_timer.stop()
                self.mascot_overlay.hide()
                self._set_chroma_status("⚪ Overlay đã tắt")
        self.save_config()

    def _set_chroma_status(self, msg: str):
        if hasattr(self, 'lbl_chroma_status'):
            self.lbl_chroma_status.setText(msg)

