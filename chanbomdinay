    def closeEvent(self, event):
        self.running = False
        if hasattr(self, 'mascot_overlay') and self.mascot_overlay:
            try:
                self.mascot_overlay.close()
            except Exception:
                pass
        if hasattr(self, 'hud_features_overlay') and self.hud_features_overlay:
            try:
                self.hud_features_overlay.stop()
                self.hud_features_overlay.close()
            except Exception:
                pass
        if self.h_proc:
            try: kernel32.CloseHandle(self.h_proc)
            except: pass
        event.accept()


