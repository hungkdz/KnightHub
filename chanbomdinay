SetParent_fn = user32.SetParent
SetParent_fn.restype = ctypes.wintypes.HWND
SetParent_fn.argtypes = [ctypes.wintypes.HWND, ctypes.wintypes.HWND]

SetWindowPos_fn = user32.SetWindowPos
SetWindowPos_fn.restype = ctypes.c_bool
SetWindowPos_fn.argtypes = [
    ctypes.wintypes.HWND, ctypes.wintypes.HWND,
    ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.c_int,
    ctypes.c_uint
]

HWND_TOP    = ctypes.c_void_p(0)
HWND_TOPMOST = ctypes.c_void_p(-1)


class AnimeOverlayWindow(QWidget):
    """
    Overlay anime được INJECT thực sự vào cửa sổ game bằng Win32 SetParent.

    Cơ chế:
    - Dùng user32.SetParent() để biến overlay thành WS_CHILD của game HWND.
    - Overlay di chuyển trong tọa độ CLIENT của game → cảm giác là UI game.
    - Phạm vi kéo thả bị giới hạn hoàn toàn trong vùng client của game.
    - Hỗ trợ MP4 green-screen (chroma key bằng OpenCV) VÀ APNG/GIF (PIL).
    - Resize bằng kéo góc dưới phải hoặc scroll chuột.
    - Tự ẩn khi game minimize / Alt-Tab sang app khác.
    """
    sig_frames_ready = Signal(list, list)   # list of (bytes, w, h), list of durations(ms)
    sig_load_status  = Signal(str)          # status message
    sig_request_show = Signal()             # yêu cầu show từ thread

    RESIZE_ZONE = 18   # px vùng resize ở góc dưới phải
    SCALE_STEP  = 20
    MIN_SIZE    = 80
    MAX_SIZE    = 800

    def __init__(self, parent_app=None):
        super().__init__(None)  # Top-level window được quản lý bám sát game
        self.parent_app = parent_app

        # Qt window flags: frameless, transparent, top-most, tool (không hiện taskbar), không lấy focus
        flags = Qt.FramelessWindowHint | Qt.Window | Qt.WindowStaysOnTopHint | Qt.Tool
        if hasattr(Qt, 'WindowDoesNotAcceptFocus'):
            flags |= Qt.WindowDoesNotAcceptFocus
        self.setWindowFlags(flags)
        self.setAttribute(Qt.WA_TranslucentBackground, True)
        self.setAttribute(Qt.WA_ShowWithoutActivating, True)
        self.setAttribute(Qt.WA_NoSystemBackground, True)

        # ── State ──────────────────────────────────────────────────
        self.overlay_size    = 220
        self.dock_corner     = 'bottom_right'
        self.dock_to_game    = True
        self.click_through   = False
        self.opacity_val     = 1.0
        self.speed_multiplier = 1.0

        # Vị trí tương đối trong client game (sau khi user drag)
        self._rel_x: int | None = None
        self._rel_y: int | None = None

        # Drag state
        self._drag_active      = False
        self._drag_start_local = QPoint()   # local pos khi bắt đầu drag
        self._drag_start_rel   = (0, 0)     # (rel_x, rel_y) khi bắt đầu drag

        # Resize state
        self._resizing          = False
        self._resize_start_x    = 0
        self._resize_start_y    = 0
        self._resize_start_size = 220

        # Win32 injection state (Cho OBS capture cửa sổ game nhận diện làm child)
        self._injected_into: int = 0
        self._is_child_mode: bool = False

        # Chroma key settings (greenscreen)
        self.chroma_hue_min = 35
        self.chroma_hue_max = 85
        self.chroma_sat_min = 70
        self.chroma_val_min = 50

        # ── Media state ────────────────────────────────────────────
        self.video_path      = ""
        self._pixmap_cache   : list[QPixmap] = []
        self._durations_ms   : list[int]     = []  # ms per frame (for GIF/APNG)
        self._frame_index    = 0
        self._video_fps      = 24.0
        self._loading        = False
        self._current_pixmap : QPixmap | None = None

        self.setFixedSize(self.overlay_size, self.overlay_size)
        self.setCursor(Qt.SizeAllCursor)

        # ── Signals ────────────────────────────────────────────────
        self.sig_frames_ready.connect(self._on_frames_ready)
        self.sig_load_status.connect(self._on_load_status)
        self.sig_request_show.connect(self._do_show)

        # Frame timer – dùng duration per-frame cho GIF/APNG hoặc fps cố định cho MP4
        self._frame_timer = QTimer(self)
        self._frame_timer.timeout.connect(self._next_frame)

        # Sync timer: 30ms duy trì đồng bộ vị trí với game
        self._track_timer = QTimer(self)
        self._track_timer.timeout.connect(self._sync_with_game)
        self._track_timer.start(30)

    # ══════════════════════════════════════════════════════════════
    #  Media Loading
    # ══════════════════════════════════════════════════════════════

    def reload_media(self, video_path: str = ""):
        """Load media – tự động phát hiện loại file:
        - MP4/AVI/MOV/MKV/WEBM → chroma-key bằng OpenCV
        - APNG/GIF              → dùng PIL (kênh alpha thực)
        """
        if video_path:
            self.video_path = video_path

        if not self.video_path or not os.path.exists(self.video_path):
            webp = get_resource_path("mascot_overlay.webp")
            if os.path.exists(webp):
                # Dùng _load_pil_thread để load mascot mặc định (thread-safe)
                self.video_path = webp
                self._loading = True
                self._frame_timer.stop()
                self._pixmap_cache.clear()
                self._durations_ms.clear()
                self._frame_index = 0
                self.sig_load_status.emit("⏳ Đang tải mascot...")
                threading.Thread(target=self._load_pil_thread, daemon=True).start()
            else:
                self.sig_load_status.emit("⚪ Chưa chọn file media")
            return

        if self._loading:
            return
        self._loading = True
        self._frame_timer.stop()
        self._pixmap_cache.clear()
        self._durations_ms.clear()
        self._frame_index = 0

        ext = os.path.splitext(self.video_path)[1].lower()
        if ext in ('.apng', '.gif', '.webp', '.png'):
            # PIL path (hỗ trợ kênh alpha thực → không cần chroma key)
            self.sig_load_status.emit("⏳ Đang tải animation...")
            t = threading.Thread(target=self._load_pil_thread, daemon=True)
        else:
            # OpenCV + chroma-key path cho video green-screen
            self.sig_load_status.emit("⏳ Đang xử lý chroma key video...")
            t = threading.Thread(target=self._load_video_thread, daemon=True)
        t.start()

    # ── PIL path (APNG / GIF) ──────────────────────────────────────

    def _load_pil_thread(self):
        """Thread: đọc APNG/GIF bằng PIL, emit raw bytes sang Qt main thread."""
        if not _HAS_PIL:
            self._loading = False
            self.sig_load_status.emit("❌ Cần cài Pillow: pip install Pillow")
            return
        try:
            img = Image.open(self.video_path)
            frames_data : list[tuple] = []  # (bytes, w, h)
            durations   : list[int]   = []
            sz = self.overlay_size

            for frame in ImageSequence.Iterator(img):
                fr = frame.convert("RGBA")
                ow, oh = fr.size
                ratio  = sz / max(ow, oh)
                nw, nh = int(ow * ratio), int(oh * ratio)
                fr = fr.resize((nw, nh), Image.LANCZOS)
                # Đặt lên nền trong suốt sz×sz
                bg = Image.new("RGBA", (sz, sz), (0, 0, 0, 0))
                ox, oy = (sz - nw) // 2, (sz - nh) // 2
                bg.paste(fr, (ox, oy), fr)

                # Chỉ lưu raw bytes – KHÔNG tạo QPixmap trong thread này
                raw = bg.tobytes("raw", "BGRA")
                frames_data.append((bytes(raw), sz, sz))
                dur = int(frame.info.get("duration", 80))
                durations.append(max(dur, 16))

            self._loading = False
            if frames_data:
                self.sig_frames_ready.emit(frames_data, durations)
            else:
                self.sig_load_status.emit("⚠️ Không đọc được frame nào")
        except Exception as e:
            self._loading = False
            self.sig_load_status.emit(f"❌ Lỗi: {str(e)[:40]}")

    # ── OpenCV / chroma-key path ───────────────────────────────────

    def _load_video_thread(self):
        """Thread: đọc video MP4, chroma key từng frame, emit raw bytes sang Qt main thread."""
        try:
            cap = cv2.VideoCapture(self.video_path)
            if not cap.isOpened():
                self._loading = False
                self.sig_load_status.emit("❌ Không mở được file video")
                return

            fps = cap.get(cv2.CAP_PROP_FPS)
            if not fps or fps <= 0 or math.isnan(fps):
                fps = 24.0
            fps = min(60.0, max(10.0, fps))
            self._video_fps = fps
            dur_ms = max(16, int(1000.0 / fps))

            frames_data : list[tuple] = []  # (bytes, w, h)
            durations   : list[int]   = []
            sz = self.overlay_size

            while True:
                ret, frame = cap.read()
                if not ret or frame is None:
                    break
                frame = cv2.resize(frame, (sz, sz), interpolation=cv2.INTER_LINEAR)
                bgra  = self._chroma_key(frame)
                # Chỉ lưu raw bytes – KHÔNG tạo QPixmap trong thread này
                frames_data.append((bytes(bgra.tobytes()), sz, sz))
                durations.append(dur_ms)

            cap.release()
            self._loading = False

            if frames_data:
                self.sig_frames_ready.emit(frames_data, durations)
            else:
                self.sig_load_status.emit("⚠️ Video không có frame nào")
        except Exception as e:
            self._loading = False
            self.sig_load_status.emit(f"❌ Lỗi: {str(e)[:30]}")

    def _chroma_key(self, bgr_frame: np.ndarray) -> np.ndarray:
        """Xóa nền xanh lá (chroma key) bằng HSV mask. Trả về BGRA."""
        hsv = cv2.cvtColor(bgr_frame, cv2.COLOR_BGR2HSV)
        lower = np.array([self.chroma_hue_min, self.chroma_sat_min, self.chroma_val_min], dtype=np.uint8)
        upper = np.array([self.chroma_hue_max, 255, 255], dtype=np.uint8)
        mask_green = cv2.inRange(hsv, lower, upper)

        kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (3, 3))
        mask_green = cv2.morphologyEx(mask_green, cv2.MORPH_DILATE, kernel, iterations=1)
        mask_green = cv2.GaussianBlur(mask_green, (5, 5), 0)
        alpha = cv2.bitwise_not(mask_green)

        bgr = bgr_frame.copy()
        spill_mask = (mask_green > 10) & (mask_green < 220)
        if np.any(spill_mask):
            b, g, r = cv2.split(bgr)
            avg = ((b.astype(np.int32) + r.astype(np.int32)) // 2).astype(np.uint8)
            g   = np.where(spill_mask, np.minimum(g, avg), g)
            bgr = cv2.merge([b, g, r])

        bgra = cv2.cvtColor(bgr, cv2.COLOR_BGR2BGRA)
        bgra[:, :, 3] = alpha
        return np.ascontiguousarray(bgra)

    def set_speed_multiplier(self, spd: float):
        self.speed_multiplier = max(0.1, min(5.0, float(spd)))

    def _get_scaled_duration(self, raw_ms: int) -> int:
        spd = getattr(self, 'speed_multiplier', 1.0)
        if spd <= 0:
            spd = 1.0
        return max(10, int(raw_ms / spd))

    def _on_frames_ready(self, frames_data: list, durations: list):
        """Nhận raw frame data từ thread và chuyển thành QPixmap trong main thread."""
        pixmaps: list[QPixmap] = []
        for item in frames_data:
            raw, w, h = item
            # QPixmap chỉ được tạo trong main thread – đúng chỗ này
            qimg = QImage(raw, w, h, w * 4, QImage.Format_ARGB32)
            pix  = QPixmap.fromImage(qimg)
            if not pix.isNull():
                pixmaps.append(pix)

        self._pixmap_cache  = pixmaps
        self._durations_ms  = durations
        self._frame_index   = 0

        if pixmaps:
            self._current_pixmap = pixmaps[0]
            dur0 = durations[0] if durations else 42
            self._frame_timer.start(self._get_scaled_duration(dur0))
            self.update()
            self.sig_load_status.emit(
                f"✅ Đang phát — {len(pixmaps)} frames @ ~{int(1000/(self._get_scaled_duration(dur0)))}fps"
            )
            if (getattr(self.parent_app, 'anime_overlay_enabled', False)
                    or getattr(self.parent_app, 'mascot_overlay_enabled', False)):
                self._sync_with_game()

    def _on_load_status(self, msg: str):
        if self.parent_app and hasattr(self.parent_app, '_set_chroma_status'):
            self.parent_app._set_chroma_status(msg)

    def _load_animated_pil(self, path: str):
        """Load trực tiếp trên GUI thread (dùng khi path là webp/fallback nhỏ)."""
        if not _HAS_PIL:
            return
        self._loading = True
        t = threading.Thread(target=self._load_pil_thread, daemon=True)
        self.video_path = path
        t.start()

    def _next_frame(self):
        """Chuyển sang frame tiếp theo, lên lịch cho frame sau theo đúng duration."""
        if not self._pixmap_cache:
            return
        self._current_pixmap = self._pixmap_cache[self._frame_index]
        self._frame_index    = (self._frame_index + 1) % len(self._pixmap_cache)
        self.update()
        # Lên lịch frame tiếp theo với đúng duration của nó (có tính tốc độ)
        if self._durations_ms:
            dur = self._durations_ms[self._frame_index]
            self._frame_timer.start(self._get_scaled_duration(dur))

    # ══════════════════════════════════════════════════════════════
    #  Win32 Injection / Sync (SetParent cho OBS Capture)
    # ══════════════════════════════════════════════════════════════

    def _get_game_hwnd(self) -> int:
        """Tìm HWND chính của cửa sổ game Play Together."""
        hwnd = 0
        try:
            pid = getattr(self.parent_app, 'pid', None)
            hwnd = find_game_hwnd(pid)
        except Exception:
            pass
        return hwnd if (hwnd and user32.IsWindow(hwnd)) else 0

    def _inject_into_game(self, hwnd_game: int):
        """
        Inject thực sự vào cửa sổ game qua Win32 SetParent:
        Bằng cách biến Overlay thành WS_CHILD của game HWND, các phần mềm quay màn hình
        như OBS (Window Capture) sẽ quay được Overlay như một thành phần gốc của Game UI.
        """
        hwnd_ov = int(self.winId())
        if not hwnd_ov or not user32.IsWindow(hwnd_ov) or not user32.IsWindow(hwnd_game):
            return

        try:
            # 1. Chuyển style → WS_CHILD (bỏ WS_POPUP)
            style = get_window_long(hwnd_ov, GWL_STYLE)
            style = (style & ~WS_POPUP) | WS_CHILD | WS_VISIBLE | WS_CLIPSIBLINGS
            set_window_long(hwnd_ov, GWL_STYLE, style)

            # 2. Giữ WS_EX_LAYERED cho nền trong suốt
            ex_style = get_window_long(hwnd_ov, GWL_EXSTYLE)
            ex_style |= WS_EX_LAYERED
            if self.click_through:
                ex_style |= WS_EX_TRANSPARENT
            set_window_long(hwnd_ov, GWL_EXSTYLE, ex_style)

            # 3. Gán Parent → Game HWND
            SetParent_fn(hwnd_ov, hwnd_game)
            self._injected_into = hwnd_game
            self._is_child_mode  = True

            # 4. Đặt vị trí ban đầu trong client area của game
            rx, ry = self._calc_dock_rel(hwnd_game)
            self._rel_x, self._rel_y = rx, ry
            SetWindowPos_fn(
                hwnd_ov, HWND_TOP,
                rx, ry,
                self.overlay_size, self.overlay_size,
                SWP_NOACTIVATE | SWP_SHOWWINDOW | SWP_FRAMECHANGED
            )
        except Exception:
            pass

    def _detach_from_game(self):
        """Gỡ Overlay khỏi game khi tắt (trả về WS_POPUP)."""
        if not self._is_child_mode:
            return
        hwnd_ov = int(self.winId())
        try:
            SetParent_fn(hwnd_ov, 0)
            style = get_window_long(hwnd_ov, GWL_STYLE)
            style = (style & ~WS_CHILD) | WS_POPUP | WS_VISIBLE
            set_window_long(hwnd_ov, GWL_STYLE, style)
            SetWindowPos_fn(
                hwnd_ov, HWND_TOP, 0, 0, 0, 0,
                SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER | SWP_FRAMECHANGED
            )
        except Exception:
            pass
        self._injected_into = 0
        self._is_child_mode  = False

    def _is_game_or_tool_active(self, hwnd_game: int) -> bool:
        """Kiểm tra xem Game hoặc Tool (hoặc bất kỳ sub-window/dialog nào) có đang active không."""
        fg = user32.GetForegroundWindow()
        if not fg or not user32.IsWindow(fg):
            return False

        ov_hwnd = int(self.winId()) if self.winId() else 0
        tool_hwnd = int(self.parent_app.winId()) if (self.parent_app and hasattr(self.parent_app, 'winId')) else 0

        if fg in (hwnd_game, ov_hwnd, tool_hwnd):
            return True

        # Check root owner (sub-windows/dialogs của game hoặc tool)
        try:
            root = user32.GetAncestor(fg, 3)  # GA_ROOTOWNER
            if root in (hwnd_game, ov_hwnd, tool_hwnd):
                return True
        except Exception:
            pass

        # Check process ID của foreground window với game PID hoặc tool PID
        try:
            fg_pid = ctypes.wintypes.DWORD()
            user32.GetWindowThreadProcessId(fg, ctypes.byref(fg_pid))
            if fg_pid.value:
                game_pid = ctypes.wintypes.DWORD()
                user32.GetWindowThreadProcessId(hwnd_game, ctypes.byref(game_pid))
                if game_pid.value and fg_pid.value == game_pid.value:
                    return True

                tool_pid = getattr(self.parent_app, 'pid', None) or os.getpid()
                if tool_pid and fg_pid.value == tool_pid:
                    return True
        except Exception:
            pass

        return False

    def _calc_dock_rel(self, hwnd_game: int) -> tuple[int, int]:
        """Tính tọa độ client (relative) cho vị trí dock."""
        rc = ctypes.wintypes.RECT()
        user32.GetClientRect(hwnd_game, ctypes.byref(rc))
        gw, gh = rc.right, rc.bottom
        sz, margin = self.overlay_size, 15
        corner = getattr(self, 'dock_corner', 'bottom_right')
        if corner == 'bottom_right':
            return gw - sz - margin, gh - sz - margin
        elif corner == 'bottom_left':
            return margin, gh - sz - margin
        elif corner == 'top_right':
            return gw - sz - margin, margin
        else:  # top_left
            return margin, margin

    def _clamp_to_game(self, hwnd_game: int, rx: int, ry: int) -> tuple[int, int]:
        """Giới hạn tọa độ overlay trong vùng client của game."""
        rc = ctypes.wintypes.RECT()
        user32.GetClientRect(hwnd_game, ctypes.byref(rc))
        gw, gh = rc.right, rc.bottom
        sz = self.overlay_size
        rx = max(0, min(rx, gw - sz))
        ry = max(0, min(ry, gh - sz))
        return rx, ry

    def _sync_with_game(self):
        """Timer callback: duy trì vị trí bám sát theo cửa sổ game."""
        is_enabled = (
            getattr(self.parent_app, 'anime_overlay_enabled', False) or
            getattr(self.parent_app, 'mascot_overlay_enabled', False)
        )

        hwnd_game = self._get_game_hwnd()

        # Tắt hoặc game không mở → ẩn và detach
        if not is_enabled or not hwnd_game or not user32.IsWindowVisible(hwnd_game):
            if self._is_child_mode:
                self._detach_from_game()
            if self.isVisible():
                self.hide()
            return

        # Game minimize → ẩn và gỡ parent để khi khôi phục (un-minimize) sẽ re-inject lại sạch
        if user32.IsIconic(hwnd_game):
            if self._is_child_mode:
                self._detach_from_game()
            if self.isVisible():
                self.hide()
            return

        # ── Inject vào Game HWND để biến Overlay thành cửa sổ con (WS_CHILD) chính thức của Game ─────────
        # Việc này giúp các phần mềm quay video/livestream (như OBS Window Capture, Discord, Bandicam)
        # quay cửa sổ Game là quay luôn cả Overlay như một thành phần giao diện gốc của Game.
        if self._injected_into != hwnd_game or not self._is_child_mode:
            if self._is_child_mode:
                self._detach_from_game()
            self._inject_into_game(hwnd_game)

        # Lấy kích thước client game
        rc = ctypes.wintypes.RECT()
        user32.GetClientRect(hwnd_game, ctypes.byref(rc))
        gw, gh = rc.right, rc.bottom
        if gw < 50 or gh < 50:
            if self.isVisible():
                self.hide()
            return

        # Tính relative (rx, ry) trong client game
        if self.dock_to_game or self._rel_x is None:
            rx, ry = self._calc_dock_rel(hwnd_game)
            self._rel_x, self._rel_y = rx, ry
        else:
            rx, ry = self._clamp_to_game(hwnd_game, self._rel_x, self._rel_y)
            self._rel_x, self._rel_y = rx, ry

        # Hiện window nếu đang ẩn ở cấp Qt
        if not self.isVisible():
            self.show()

        # Đảm bảo hiển thị và cập nhật vị trí ở cấp Win32 API
        hwnd_ov = int(self.winId())
        if hwnd_ov and user32.IsWindow(hwnd_ov):
            if not user32.IsWindowVisible(hwnd_ov):
                user32.ShowWindow(hwnd_ov, 8)  # SW_SHOWNA = 8 (Hiển thị không chiếm focus)

            SetWindowPos_fn(
                hwnd_ov, HWND_TOP,
                rx, ry,
                self.overlay_size, self.overlay_size,
                SWP_NOACTIVATE | SWP_SHOWWINDOW | SWP_FRAMECHANGED
            )

    # ══════════════════════════════════════════════════════════════
    #  Paint
    # ══════════════════════════════════════════════════════════════

    def paintEvent(self, event):
        """Vẽ frame hiện tại + resize handle ở góc dưới phải."""
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        p.setRenderHint(QPainter.SmoothPixmapTransform)

        if self._current_pixmap and not self._current_pixmap.isNull():
            p.drawPixmap(0, 0, self.width(), self.height(), self._current_pixmap)
        else:
            # Placeholder khi chưa có media
            p.setBrush(QBrush(QColor(26, 26, 46, 200)))
            p.setPen(QPen(QColor("#e94560"), 2))
            s = self.overlay_size
            p.drawRoundedRect(2, 2, s - 4, s - 4, 12, 12)
            p.setPen(QPen(QColor("#9090b8")))
            p.setFont(QFont("Segoe UI", max(8, s // 14)))
            p.drawText(self.rect(), Qt.AlignCenter, "Click phải\nđể mở file")

        # Vẽ resize handle (3 đường chéo ở góc dưới phải)
        s = self.overlay_size
        z = self.RESIZE_ZONE
        pen = QPen(QColor("#e94560"), 1.5)
        p.setPen(pen)
        for i in range(3):
            offset = 4 + i * 5
            p.drawLine(s - offset, s - 2, s - 2, s - offset)
        p.end()

    # ══════════════════════════════════════════════════════════════
    #  Mouse Events – Drag (giới hạn trong game) & Resize
    # ══════════════════════════════════════════════════════════════

    def _in_resize_zone(self, lx: int, ly: int) -> bool:
        z = self.RESIZE_ZONE
        s = self.overlay_size
        return lx >= s - z and ly >= s - z

    def mousePressEvent(self, event):
        if self.click_through:
            return
        if event.button() == Qt.LeftButton:
            lx, ly = event.position().x(), event.position().y()
            if self._in_resize_zone(int(lx), int(ly)):
                self._resizing          = True
                self._resize_start_x    = event.globalPosition().x()
                self._resize_start_y    = event.globalPosition().y()
                self._resize_start_size = self.overlay_size
                self.setCursor(Qt.SizeFDiagCursor)
            else:
                self._resizing          = False
                self._drag_active       = True
                self._drag_start_local  = event.position().toPoint()
                self._drag_start_rel    = (
                    self._rel_x if self._rel_x is not None else 0,
                    self._rel_y if self._rel_y is not None else 0
                )
                self.dock_to_game = False
                self.setCursor(Qt.SizeAllCursor)
            event.accept()
        elif event.button() == Qt.RightButton:
            self._show_context_menu(event.globalPosition().toPoint())
            event.accept()

    def mouseMoveEvent(self, event):
        if self.click_through:
            return
        lx, ly = int(event.position().x()), int(event.position().y())

        if self._resizing:
            gx, gy = event.globalPosition().x(), event.globalPosition().y()
            dx = gx - self._resize_start_x
            dy = gy - self._resize_start_y
            delta    = int((dx + dy) / 2)
            new_size = max(self.MIN_SIZE, min(self.MAX_SIZE, self._resize_start_size + delta))
            if new_size != self.overlay_size:
                self.set_overlay_size(new_size)
            event.accept()
            return

        if self._drag_active and (event.buttons() & Qt.LeftButton):
            # Di chuyển trong tọa độ client của game
            gx = int(event.globalPosition().x())
            gy = int(event.globalPosition().y())

            hwnd_game = self._get_game_hwnd()
            if hwnd_game:
                if self._is_child_mode:
                    pt = ctypes.wintypes.POINT(gx, gy)
                    user32.ScreenToClient(hwnd_game, ctypes.byref(pt))
                    new_rx = pt.x - self._drag_start_local.x()
                    new_ry = pt.y - self._drag_start_local.y()
                else:
                    pt = ctypes.wintypes.POINT(0, 0)
                    user32.ClientToScreen(hwnd_game, ctypes.byref(pt))
                    client_screen_x, client_screen_y = pt.x, pt.y
                    new_rx = gx - client_screen_x - self._drag_start_local.x()
                    new_ry = gy - client_screen_y - self._drag_start_local.y()

                new_rx, new_ry = self._clamp_to_game(hwnd_game, new_rx, new_ry)
                self._rel_x, self._rel_y = new_rx, new_ry
                self.dock_to_game = False

                hwnd_ov = int(self.winId())
                SetWindowPos_fn(
                    hwnd_ov, HWND_TOP,
                    new_rx, new_ry,
                    self.overlay_size, self.overlay_size,
                    SWP_NOACTIVATE | SWP_SHOWWINDOW
                )
            event.accept()

    def mouseReleaseEvent(self, event):
        if event.button() == Qt.LeftButton:
            self._drag_active = False
            self._resizing    = False
            self.setCursor(Qt.SizeAllCursor)
        event.accept()

    def wheelEvent(self, event):
        """Scroll chuột để resize overlay."""
        if self.click_through:
            return
        delta = event.angleDelta().y()
        if delta > 0:
            new_size = min(self.overlay_size + self.SCALE_STEP, self.MAX_SIZE)
        else:
            new_size = max(self.overlay_size - self.SCALE_STEP, self.MIN_SIZE)
        if new_size != self.overlay_size:
            self.set_overlay_size(new_size)
        event.accept()

    # ══════════════════════════════════════════════════════════════
    #  Context Menu (Right-click)
    # ══════════════════════════════════════════════════════════════

    def _show_context_menu(self, global_pos: QPoint):
        from PySide6.QtWidgets import QMenu
        menu = QMenu(self)
        menu.setStyleSheet(
            "QMenu{background:#1a1a2e;color:#e0e0f0;border:1px solid #e94560;border-radius:6px;padding:4px;}"
            "QMenu::item{padding:6px 18px;border-radius:4px;}"
            "QMenu::item:selected{background:#e94560;}"
        )
        act_open = menu.addAction("📂 Mở file APNG/GIF/MP4")
        menu.addSeparator()
        act_dock = menu.addAction("📍 Neo về góc")
        act_ct   = menu.addAction("🖱️ Click-through: " + ("BẬT" if self.click_through else "TẮT"))
        menu.addSeparator()
        act_hide = menu.addAction("❌ Ẩn Overlay")

        act = menu.exec(global_pos)
        if act == act_open:
            self._browse_media()
        elif act == act_dock:
            self.dock_to_game = True
            self._sync_with_game()
        elif act == act_ct:
            self.set_click_through(not self.click_through)
        elif act == act_hide:
            if self.parent_app:
                self.parent_app.anime_overlay_enabled = False
                self.parent_app.mascot_overlay_enabled = False
                if hasattr(self.parent_app, 'sw_anime_overlay'):
                    self.parent_app.sw_anime_overlay.setChecked(False)

    def _browse_media(self):
        """Mở dialog chọn file media."""
        try:
            from PySide6.QtWidgets import QFileDialog
            path, _ = QFileDialog.getOpenFileName(
                None, "Chọn file animation / video",
                "",
                "Media (*.apng *.gif *.mp4 *.avi *.mov *.mkv *.webm *.webp *.png);;All (*)"
            )
            if path and os.path.exists(path):
                self.reload_media(path)
                if self.parent_app:
                    self.parent_app.anime_video_path = path
                    if hasattr(self.parent_app, 'txt_video_path'):
                        self.parent_app.txt_video_path.setText(path)
                    if hasattr(self.parent_app, 'save_config'):
                        self.parent_app.save_config()
        except Exception:
            pass

    # ══════════════════════════════════════════════════════════════
    #  Public API
    # ══════════════════════════════════════════════════════════════

    def set_overlay_size(self, sz: int):
        sz = max(self.MIN_SIZE, min(self.MAX_SIZE, sz))
        self.overlay_size = sz
        self.setFixedSize(sz, sz)
        # Reload media nếu cần resize frames
        if self.video_path and os.path.exists(self.video_path) and not self._loading:
            self.reload_media(self.video_path)
        # Đồng bộ lại vị trí
        self._sync_with_game()
        self.update()

    def set_overlay_opacity(self, op: float):
        self.opacity_val = max(0.05, min(1.0, op))
        self.setWindowOpacity(self.opacity_val)

    def set_dock_corner(self, corner: str):
        self.dock_corner  = corner
        self.dock_to_game = True
        self._sync_with_game()

    def set_click_through(self, enabled: bool):
        """Bật/tắt xuyên chuột."""
        self.click_through = enabled
        self.setAttribute(Qt.WA_TransparentForMouseEvents, enabled)
        try:
            hwnd_ov  = int(self.winId())
            ex_style = get_window_long(hwnd_ov, GWL_EXSTYLE)
            if enabled:
                ex_style |= (WS_EX_TRANSPARENT | WS_EX_LAYERED)
            else:
                ex_style = (ex_style & ~WS_EX_TRANSPARENT) | WS_EX_LAYERED
            set_window_long(hwnd_ov, GWL_EXSTYLE, ex_style)
        except Exception:
            pass

    def _do_show(self):
        self.show()

    def stop(self):
        self._frame_timer.stop()
        self._track_timer.stop()
        if self._is_child_mode:
            self._detach_from_game()
        self.hide()


# Alias for backward compat
MascotOverlayWindow = AnimeOverlayWindow


def _ease_out_back(t: float) -> float:
    t = max(0.0, min(1.0, t))
    c1 = 1.25
    c3 = c1 + 1.0
    return 1.0 + c3 * ((t - 1.0) ** 3) + c1 * ((t - 1.0) ** 2)

def _ease_out_cubic(t: float) -> float:
    t = max(0.0, min(1.0, t))
    return 1.0 - (1.0 - t) ** 3


class FeatureItemAnim:
    """Quản lý trạng thái và animation morph của từng tính năng trên HUD."""
    def __init__(self, key: str, icon: str, name: str, extra: str, color: QColor):
        self.key = key
        self.icon = icon
        self.name = name
        self.extra = extra
        self.color = color
        self.progress = 0.0          # 0.0 (từ ngoài viền game) -> 1.0 (vào vị trí chuẩn)
        self.current_y = 0.0         # Tọa độ Y hiện tại (trượt dọc morph mượt mà)
        self.target_y = 0.0          # Tọa độ Y mục tiêu
        self.is_exiting = False      # Đang trượt ngược về viền khi tắt


class FeatureHudOverlayWindow(QWidget):
    """
    Overlay HUD hiển thị danh sách các tính năng đang bật lên màn hình game.
    Được INJECT thực sự vào cửa sổ game Play Together bằng Win32 SetParent (WS_CHILD)
    kết hợp WS_EX_LAYERED và WS_EX_TRANSPARENT:
    - Nằm ở phía bên trái giao diện game.
    - Hiệu ứng morph trượt mượt mà từ viền game vào (smooth slide-in + morph from border).
    - Tự động tính toán DPI scale chuẩn xác (High-DPI aware), không bị cắt chữ hay mất thẻ.
    - Cho phép click chuột xuyên thấu (WS_EX_TRANSPARENT), không cản trở thao tác chơi game.
    - OBS, Discord, Bandicam và các app quay video nhận diện là của game và quay được 100%.
    """
    def __init__(self, parent_app=None):
        super().__init__(None)
        self.parent_app = parent_app

        flags = Qt.FramelessWindowHint | Qt.Window | Qt.WindowStaysOnTopHint | Qt.Tool
        if hasattr(Qt, 'WindowDoesNotAcceptFocus'):
            flags |= Qt.WindowDoesNotAcceptFocus
        self.setWindowFlags(flags)
        self.setAttribute(Qt.WA_TranslucentBackground, True)
        self.setAttribute(Qt.WA_ShowWithoutActivating, True)
        self.setAttribute(Qt.WA_NoSystemBackground, True)

        self._injected_into: int = 0
        self._is_child_mode: bool = False
        self._items: list[FeatureItemAnim] = []
        self._header_progress: float = 0.0

        # Kích thước cơ sở (Logical pixels)
        self._base_card_w = 265
        self._base_x = 16
        self._total_w = self._base_x + self._base_card_w + 10  # 291px
        self._card_h = 36
        self._spacing = 6
        self._header_h = 28

        self.resize(self._total_w, 100)

        # Timer animation morph tốc độ cao (16ms = ~60 FPS mượt mà)
        self._anim_timer = QTimer(self)
        self._anim_timer.timeout.connect(self._on_anim_tick)
        self._anim_timer.start(16)

        # Timer đồng bộ với game (30ms)
        self._sync_timer = QTimer(self)
        self._sync_timer.timeout.connect(self._sync_with_game)
        self._sync_timer.start(30)

    def _get_game_hwnd(self) -> int:
        hwnd = 0
        try:
            pid = getattr(self.parent_app, 'pid', None)
            hwnd = find_game_hwnd(pid)
        except Exception:
            pass
        return hwnd if (hwnd and user32.IsWindow(hwnd)) else 0

    def _inject_into_game(self, hwnd_game: int):
        hwnd_ov = int(self.winId())
        if not hwnd_ov or not user32.IsWindow(hwnd_ov) or not user32.IsWindow(hwnd_game):
            return
        try:
            # 1. Chuyển style sang WS_CHILD
            style = get_window_long(hwnd_ov, GWL_STYLE)
            style = (style & ~WS_POPUP) | WS_CHILD | WS_VISIBLE | WS_CLIPSIBLINGS
            set_window_long(hwnd_ov, GWL_STYLE, style)

            # 2. Giữ Layered + Transparent (Click-through để không cản trở thao tác game)
            ex_style = get_window_long(hwnd_ov, GWL_EXSTYLE)
            ex_style |= WS_EX_LAYERED | WS_EX_TRANSPARENT
            set_window_long(hwnd_ov, GWL_EXSTYLE, ex_style)

            # 3. Gán Parent sang game HWND (OBS Window/Game Capture sẽ quay cả overlay)
            SetParent_fn(hwnd_ov, hwnd_game)
            self._injected_into = hwnd_game
            self._is_child_mode = True

            # 4. Đặt vị trí bám sát mép trái client area
            dpr = self.devicePixelRatioF() or 1.0
            rx = 0
            ry = self._calc_top_y(hwnd_game)
            phys_x = int(round(rx * dpr))
            phys_y = int(round(ry * dpr))
            phys_w = int(round(self._total_w * dpr))
            phys_h = int(round(self.height() * dpr))

            SetWindowPos_fn(
                hwnd_ov, HWND_TOP,
                phys_x, phys_y,
                phys_w, phys_h,
                SWP_NOACTIVATE | SWP_SHOWWINDOW | SWP_FRAMECHANGED
            )
        except Exception:
            pass

    def _detach_from_game(self):
        if not self._is_child_mode:
            return
        hwnd_ov = int(self.winId())
        try:
            SetParent_fn(hwnd_ov, 0)
            style = get_window_long(hwnd_ov, GWL_STYLE)
            style = (style & ~WS_CHILD) | WS_POPUP | WS_VISIBLE
            set_window_long(hwnd_ov, GWL_STYLE, style)
            SetWindowPos_fn(
                hwnd_ov, HWND_TOP, 0, 0, 0, 0,
                SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER | SWP_FRAMECHANGED
            )
        except Exception:
            pass
        self._injected_into = 0
        self._is_child_mode = False

    def _calc_top_y(self, hwnd_game: int) -> int:
        rc = ctypes.wintypes.RECT()
        user32.GetClientRect(hwnd_game, ctypes.byref(rc))
        gh = rc.bottom - rc.top
        return max(90, min(140, int(gh * 0.18)))

    def _on_anim_tick(self):
        """Cập nhật frame animation cho từng thẻ tính năng (morph slide-in / slide-out)."""
        has_active = any(not it.is_exiting for it in self._items)
        if has_active:
            self._header_progress = min(1.0, self._header_progress + 0.08)
        else:
            self._header_progress = max(0.0, self._header_progress - 0.09)

        for it in self._items:
            if not it.is_exiting:
                it.progress = min(1.0, it.progress + 0.065)
            else:
                it.progress = max(0.0, it.progress - 0.085)

            # Morph mượt mà vị trí Y khi các thẻ thêm / bớt
            if it.current_y <= 0.0:
                it.current_y = it.target_y
            else:
                it.current_y += (it.target_y - it.current_y) * 0.35

        # Loại bỏ các item đã trượt hoàn toàn ra khỏi viền màn hình
        self._items = [it for it in self._items if not (it.is_exiting and it.progress <= 0.0)]

        if self.isVisible():
            self.update()

    def _get_active_features(self) -> list[dict]:
        app = self.parent_app
        if not app:
            return []
        items = []

        # 1. Chế độ bay
        if getattr(app, 'fly_active', False):
