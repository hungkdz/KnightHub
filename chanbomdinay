    def _manual_scan_players(self):
        threading.Thread(target=self._scan_players_async, daemon=True).start()

    def _auto_scan_players_tick(self):
        if self.connected:
            threading.Thread(target=self._scan_players_async, daemon=True).start()

    def _scan_players_async(self):
        plist = self._scan_nearby_players()
        self.signals.update_players_list.emit(plist)

    def _on_search_player_changed(self, text):
        self._on_update_players_list(self.nearby_players_cache)

    def _on_update_players_list(self, players):
        self.nearby_players_cache = players
        search_kw = self.txt_search_player.text().strip().lower() if hasattr(self, 'txt_search_player') else ""

        if search_kw:
            filtered = [p for p in players if search_kw in p['name'].lower()]
        else:
            filtered = players

        if hasattr(self, 'lbl_players_count'):
            if search_kw:
                self.lbl_players_count.setText(f"👥 Người Chơi Xung Quanh ({len(filtered)}/{len(players)})")
            else:
                self.lbl_players_count.setText(f"👥 Người Chơi Xung Quanh ({len(players)})")

        if not hasattr(self, 'combo_players'):
            return

        cur_ptr = self.selected_target_player_ptr

        self.combo_players.blockSignals(True)
        self.combo_players.clear()

        if not filtered:
            if search_kw:
                self.combo_players.addItem(f"--- Không tìm thấy '{search_kw}' trong danh sách ---", None)
            else:
                self.combo_players.addItem("--- Chưa phát hiện người chơi nào gần bạn ---", None)
            self.selected_target_player_ptr = None
        else:
            select_idx = 0
            for i, p in enumerate(filtered):
                item_text = f"[{p['dist']:4.1f}m]  {p['name']}  (X:{p['x']:.1f}, Y:{p['y']:.1f}, Z:{p['z']:.1f})"
                self.combo_players.addItem(item_text, p['ptr'])
                if cur_ptr and p['ptr'] == cur_ptr:
                    select_idx = i

            self.combo_players.setCurrentIndex(select_idx)
            self.selected_target_player_ptr = self.combo_players.itemData(select_idx)
        self.combo_players.blockSignals(False)

        self._refresh_selected_player_ui()

    def _on_player_combo_changed(self, index):
        if hasattr(self, 'combo_players'):
            ptr = self.combo_players.itemData(index)
            self.selected_target_player_ptr = ptr
            self._refresh_selected_player_ui()

    def _refresh_selected_player_ui(self):
        if not hasattr(self, 'lbl_target_name'):
            return

        ptr = self.selected_target_player_ptr
        if not ptr:
            self.lbl_target_name.setText("Tên mục tiêu: Chưa chọn")
            self.lbl_target_dist.setText("Khoảng cách: 0.0 m")
            self.lbl_target_coords.setText("Tọa độ: X: 0.00 | Y: 0.00 | Z: 0.00")
            return

        for p in self.nearby_players_cache:
            if p['ptr'] == ptr:
                self.lbl_target_name.setText(f"Tên mục tiêu: {p['name']} (0x{ptr:X})")
                self.lbl_target_dist.setText(f"Khoảng cách: {p['dist']:.1f} m")
                self.lbl_target_coords.setText(f"Tọa độ: X: {p['x']:.2f} | Y: {p['y']:.2f} | Z: {p['z']:.2f}")
                return

    def _on_teleport_to_selected_player_clicked(self):
        ptr = self.selected_target_player_ptr
        if not ptr:
            QMessageBox.information(self, "Thông báo", "Vui lòng chọn một người chơi trong danh sách!")
            return

        target_p = None
        for p in self.nearby_players_cache:
            if p['ptr'] == ptr:
                target_p = p
                break

        if not target_p:
            QMessageBox.warning(self, "Cảnh báo", "Người chơi này không còn ở gần bạn!")
            return

        tx = self._read_float(ptr + 0x58)
        ty = self._read_float(ptr + 0x5c)
        tz = self._read_float(ptr + 0x60)
        if (tx == 0.0 and ty == 0.0 and tz == 0.0) or abs(tx) > 20000:
            for ctrl_off in [0x1D8, 0x68, 0x70, 0x58, 0x1B8]:
                ctrl = self._read_ptr(ptr + ctrl_off)
                if ctrl and 0x10000 < ctrl < 0x7FFFFFFFFFFF:
                    tax = self._read_float(ctrl + 0x120) or self._read_float(ctrl + 0xFC)
                    tay = self._read_float(ctrl + 0x124) or self._read_float(ctrl + 0x100)
                    taz = self._read_float(ctrl + 0x128) or self._read_float(ctrl + 0x104)
                    if not (tax == 0.0 and tay == 0.0 and taz == 0.0):
                        tx, ty, tz = tax, tay, taz
                        break
        if (tx == 0.0 and ty == 0.0 and tz == 0.0) or abs(tx) > 20000:
            tx, ty, tz = target_p['x'], target_p['y'], target_p['z']

        ok = self.teleport_to(tx, ty, tz)
        if ok:
            nick = target_p['name']
            print(f"[+] Đã dịch chuyển đến người chơi: {nick} ({tx:.2f}, {ty:.2f}, {tz:.2f})", flush=True)

