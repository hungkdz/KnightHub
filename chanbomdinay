    def _auto_hammer_loop(self):
        last_fight_time = 0.0

        while self.running:
            if not self.auto_hammer_active:
                time.sleep(0.1)
                continue

            try:
                hwnd = find_game_hwnd(self.pid)
                if not hwnd:
                    time.sleep(0.2)
                    continue

                bgr = capture_hwnd_bgr(hwnd)
                if bgr is None:
                    time.sleep(0.05)
                    continue

                is_fight = check_fight_banner(bgr)
                now = time.time()

                if is_fight:
                    if (now - last_fight_time) > 1.2:
                        last_fight_time = now
                        self.hammer_detected_count += 1

                        # ── CLICK FIRST (minimum latency) ──────────────────
                        hits = 8 if self.hammer_spam_mode else 4
                        for _ in range(hits):
                            click_at_current_cursor(hwnd)
                            self.hammer_click_count += 1
                            time.sleep(0.012)

                        if self.enable_sound_beep:
                            try: winsound.Beep(1800, 60)
                            except Exception: pass

                        # ── Then update UI ─────────────────────────────────
                        self.signals.update_hammer_status.emit(
                            "💥 PHÁT HIỆN FIGHT! -> ĐÃ CLICK!", "#a6e3a1",
                            self.hammer_detected_count, self.hammer_click_count
                        )

                    time.sleep(0.015)  # 15ms scan rate when fight is visible
                else:
                    if (now - last_fight_time) > 0.8:
                        self.signals.update_hammer_status.emit(
                            "● Đang quét tìm FIGHT!... (Để sẵn chuột)", "#a6e3a1",
                            self.hammer_detected_count, self.hammer_click_count
                        )
                    time.sleep(0.015)  # 15ms scan rate
            except Exception:
                time.sleep(0.05)

    def _global_hotkey_loop(self):
        prev_keys = {}
        space_last_press_time = 0.0
        DOUBLE_TAP_MAX_DELAY = 0.35
        DOUBLE_TAP_MIN_DELAY = 0.05

        while self.running:
            time.sleep(0.015)

            # Key recorder
            if self.listening_key_action:
                for vk_name, vk_code in VK_TABLE.items():
                    if user32.GetAsyncKeyState(vk_code) & 0x8000:
                        self.signals.key_recorded.emit(self.listening_key_action, vk_name)
                        time.sleep(0.3)
                        break
                continue

            # Double-tap Jump (SPACE)
            jump_key_name = self.keybinds.get("fly_up", "SPACE")
            vk_space = VK_TABLE.get(jump_key_name, 0x20)
            space_is_down = bool(user32.GetAsyncKeyState(vk_space) & 0x8000)
            space_was_down = prev_keys.get("space_key", False)

            if space_is_down and not space_was_down:
                now = time.time()
                diff = now - space_last_press_time
                if getattr(self, 'double_jump_to_fly', True) and (DOUBLE_TAP_MIN_DELAY < diff < DOUBLE_TAP_MAX_DELAY):
                    space_last_press_time = 0.0
                    self.signals.toggle_fly_requested.emit()
                else:
                    space_last_press_time = now
                    # Multi Jump: nhảy ngay mỗi lần nhấn SPACE (không cần chạm đất)
                    if getattr(self, 'enable_multi_jump', False) and not self.fly_active and self.connected:
                        self.do_multi_jump()

            prev_keys["space_key"] = space_is_down

            # Hotkeys for all toolkit features
            toggle_actions = [
                ("toggle_fly", self.signals.toggle_fly_requested),
                ("noclip_toggle", self.signals.toggle_noclip_requested),
                ("auto_hammer", self.signals.toggle_hammer_requested),
                ("multi_jump_toggle", self.signals.toggle_multi_jump_requested),
                ("jump_boost_toggle", self.signals.toggle_jump_boost_requested),
                ("long_jump_toggle", self.signals.toggle_long_jump_requested),
                ("lock_y_toggle", self.signals.lock_y_requested),
                ("follow_player_toggle", self.signals.toggle_follow_player_requested),
                ("anime_overlay_toggle", self.signals.toggle_anime_overlay_requested),
            ]

            for act_name, sig in toggle_actions:
                k_val = self.keybinds.get(act_name)
                if not k_val:
                    continue
                vk = VK_TABLE.get(k_val)
                if vk and vk != vk_space:
                    is_down = bool(user32.GetAsyncKeyState(vk) & 0x8000)
                    was_down = prev_keys.get(act_name, False)
                    if is_down and not was_down:
                        sig.emit()
                    prev_keys[act_name] = is_down

            # Continuous ascending / descending while holding keys
            if self.fly_active and self.connected:
                up_vk = VK_TABLE.get(self.keybinds.get("fly_up", "SPACE"))
                down_vk = VK_TABLE.get(self.keybinds.get("fly_down", "CTRL"))
                boost_vk = VK_TABLE.get(self.keybinds.get("speed_boost", "SHIFT"))

                is_boost = bool(user32.GetAsyncKeyState(boost_vk) & 0x8000) if boost_vk else False
                multiplier = 2.5 if is_boost else 1.0

                dt = 0.015
                delta_y = self.ascend_speed * multiplier * dt

                if up_vk and (user32.GetAsyncKeyState(up_vk) & 0x8000):
                    self.fly_target_y += delta_y
                elif down_vk and (user32.GetAsyncKeyState(down_vk) & 0x8000):
                    self.fly_target_y = max(-50.0, self.fly_target_y - delta_y)

    def _fly_engine_loop(self):
        import math

        DT = 0.02
        VK_W = 0x57
        VK_A = 0x41
        VK_S = 0x53
        VK_D = 0x44

        _last_time = time.perf_counter()

        while self.running:
            motor = self.motor_addr
            ctrl  = self.actor_control_addr
            player = self.local_player_addr

            if not (motor and 0x10000 < motor < 0x7FFFFFFFFFFF): motor = 0
            if not (ctrl and 0x10000 < ctrl < 0x7FFFFFFFFFFF): ctrl = 0
            if not (player and 0x10000 < player < 0x7FFFFFFFFFFF): player = 0

            now = time.perf_counter()
            dt = now - _last_time
            _last_time = now
            if dt > 0.05 or dt <= 0:
                dt = DT

            if self.fly_active and self.connected and (motor or ctrl):
                try:
                    fy = self.fly_target_y

                    if motor:
                        cx = self._read_float(motor + 0x100)
                        cz = self._read_float(motor + 0x108)

                        w_dn = bool(user32.GetAsyncKeyState(VK_W) & 0x8000)
                        a_dn = bool(user32.GetAsyncKeyState(VK_A) & 0x8000)
                        s_dn = bool(user32.GetAsyncKeyState(VK_S) & 0x8000)
                        d_dn = bool(user32.GetAsyncKeyState(VK_D) & 0x8000)

                        if w_dn or a_dn or s_dn or d_dn:
                            cam_vecs = self._get_camera_vectors()
                            if cam_vecs:
                                fx, fz, rx, rz = cam_vecs
                            else:
                                fx = self._read_float(motor + 0x148)
                                fz = self._read_float(motor + 0x150)
                                rx = self._read_float(motor + 0x154)
                                rz = self._read_float(motor + 0x15c)

                            dx = 0.0
                            dz = 0.0
                            if w_dn: dx += fx; dz += fz
                            if s_dn: dx -= fx; dz -= fz
                            if d_dn: dx += rx; dz += rz
                            if a_dn: dx -= rx; dz -= rz

                            len_sq = dx * dx + dz * dz
                            if len_sq > 0.0001:
                                inv_len = 1.0 / math.sqrt(len_sq)
                                dx *= inv_len
                                dz *= inv_len

                                base_speed = 6.0
                                mult = max(1.0, self.fly_speed_multiplier)
                                boost_vk = VK_TABLE.get(self.keybinds.get("speed_boost", "SHIFT"))
                                if boost_vk and (user32.GetAsyncKeyState(boost_vk) & 0x8000):
                                    mult *= 2.0

                                speed = base_speed * mult
                                cx += dx * speed * dt
                                cz += dz * speed * dt

                        self._write_float(motor + 0x100, cx)
                        self._write_float(motor + 0x104, fy)
                        self._write_float(motor + 0x108, cz)
                        self._write_float(motor + 0x294, cx)
                        self._write_float(motor + 0x298, fy)
                        self._write_float(motor + 0x29c, cz)
                        self._write_mem(motor + 0x292, struct.pack('B', 1))

                        self._write_float(motor + 0x114, 0.0)
                        self._write_float(motor + 0x25c, 0.0)
                        self._write_mem(motor + 0x2cd, struct.pack('B', 1))
                        self._write_float(motor + 0x2d0, 1.0)

                        if self.noclip_with_fly:
                            self._write_mem(motor + 0x290, struct.pack('B', 0))

                    if ctrl:
                        self._write_float(ctrl + 0x124, fy)
                        sync_ptr = self._read_ptr(ctrl + 0x110)
                        if sync_ptr and 0x10000 < sync_ptr < 0x7FFFFFFFFFFF:
                            self._write_float(sync_ptr + 0x1c, fy)

                    if player:
                        self._write_float(player + 0x5c, fy)

                    self.pos_y = fy
                except Exception:
                    pass

                time.sleep(DT)
            else:
                now_tick = time.perf_counter()
                dt_engine = max(0.005, min(0.05, now_tick - _last_time))
                _last_time = now_tick

                if not self.fly_active and self.connected:
                    lp = self.local_player_addr
                    ctrl = self.actor_control_addr or (self._read_ptr(lp + 0x1B8) if lp else 0) or (self._read_ptr(lp + 0x1D8) if lp else 0)
                    kin = self.kinematic_addr or (self._read_ptr(ctrl + 0x3D0) if ctrl else 0) or (self._read_ptr(ctrl + 0xA0) if ctrl else 0) or (self._read_ptr(ctrl + 0x3B0) if ctrl else 0)
                    motor = self.motor_addr or (self._read_ptr(kin + 0x20) if kin else 0)

                    # Duy trì tốc độ nhảy (Jump Boost hoặc chuẩn 14.0)
                    if kin and (0x10000 < kin < 0x7FFFFFFFFFFF):
                        target_jump_spd = self._get_effective_jump_speed()
                        cur_jump_spd = self._read_float(kin + 0x9C)
                        if abs(cur_jump_spd - target_jump_spd) > 0.1:
                            self._write_float(kin + 0x9C, target_jump_spd)

                        # Duy trì tốc độ nhảy xa (Long Jump hoặc chuẩn 8.0 / 0.0)
                        target_air_spd = self._get_effective_air_speed()
                        cur_air_spd = self._read_float(kin + 0x7C)
                        if abs(cur_air_spd - target_air_spd) > 0.1:
                            self._write_float(kin + 0x7C, target_air_spd)

                        target_buff_air = self._get_effective_buff_air_speed()
                        cur_buff_air = self._read_float(kin + 0x5C)
                        if abs(cur_buff_air - target_buff_air) > 0.1:
                            self._write_float(kin + 0x5C, target_buff_air)

                    # Multi Jump: liên tục duy trì khả năng nhảy ngay khi chưa chạm đất
                    if getattr(self, 'enable_multi_jump', False):
                        if kin and (0x10000 < kin < 0x7FFFFFFFFFFF):
                            self._write_mem(kin + 0x99, struct.pack('B', 1))   # allowDoubleJump = 1
                            self._write_mem(kin + 0xF8, struct.pack('B', 0))   # doubleJumpConsumed = 0
                            self._write_float(kin + 0xF4, 0.0)                 # timeSinceLastAbleToJump = 0.0
                            if motor and (0x10000 < motor < 0x7FFFFFFFFFFF):
                                raw_g = self._read_mem(motor + 0x89, 1)
                                is_grounded = bool(raw_g[0]) if raw_g else False
                                if not is_grounded:
                                    self._write_mem(kin + 0xED, struct.pack('B', 1)) # jumpConsumed = 1

                sleep_time = 0.02
                time.sleep(sleep_time)

    def _process_monitor_loop(self):
        # Danh sách offsets để thử (hỗ trợ nhiều phiên bản game)
        ACTOR_CTRL_OFFSETS = [0x1B8, 0x1D8, 0x68, 0x58, 0x70]
        KIN_OFFSETS        = [0x3D0, 0xA0, 0x3B0, 0xD8, 0x3C8, 0x60, 0x98, 0x138]
        MOTOR_OFFSETS      = [0x20, 0x28]

        while self.running:
            if not self.connected or not self.h_proc or not self.ga_base:
                if self._attach_game():
                    self.connected = True
                    self._chain_debug_printed = False  # reset log khi attach lại
                else:
                    self.connected = False
                    self.signals.update_coords.emit(0.0, 0.0, 0.0, False, 0)
                    time.sleep(1.0)
                    continue

            try:
                actor_rva       = self._get_actor_system_rva()
                actor_sys_class = self._read_ptr(self.ga_base + actor_rva)
                static_fields   = self._read_ptr(actor_sys_class + 0xB8) if (actor_sys_class and 0x10000 < actor_sys_class < 0x7FFFFFFFFFFF) else 0
                actor_sys_self  = self._read_ptr(static_fields + 0x00)   if (static_fields   and 0x10000 < static_fields   < 0x7FFFFFFFFFFF) else 0
                local_player    = self._read_ptr(actor_sys_self + 0x58)  if (actor_sys_self  and 0x10000 < actor_sys_self  < 0x7FFFFFFFFFFF) else 0

                actor_control = 0
                kinematic_ptr = 0
                motor_ptr     = 0

                if local_player and 0x10000 < local_player < 0x7FFFFFFFFFFF:
                    for aco in ACTOR_CTRL_OFFSETS:
                        ac = self._read_ptr(local_player + aco)
                        if not (ac and 0x10000 < ac < 0x7FFFFFFFFFFF):
                            continue
                        for ko in KIN_OFFSETS:
                            kin = self._read_ptr(ac + ko)
                            if not (kin and 0x10000 < kin < 0x7FFFFFFFFFFF):
                                continue
                            for mo in MOTOR_OFFSETS:
                                m = self._read_ptr(kin + mo)
                                if not (m and 0x10000 < m < 0x7FFFFFFFFFFF):
                                    continue
                                px = self._read_float(m + 0x100)
                                py = self._read_float(m + 0x104)
                                pz = self._read_float(m + 0x108)
                                if -20000 < px < 20000 and -2000 < py < 20000 and -20000 < pz < 20000 and (abs(px) > 0.01 or abs(pz) > 0.01):
                                    actor_control = ac
                                    kinematic_ptr = kin
                                    motor_ptr     = m
                                    self._cached_ac_off  = aco
                                    self._cached_kin_off = ko
                                    self._cached_mot_off = mo
                                    break
                            if motor_ptr: break
                        if motor_ptr: break

                # Debug log một lần duy nhất khi tìm được con trỏ
                if motor_ptr:
                    if not getattr(self, '_chain_debug_printed', False):
                        self._chain_debug_printed = True
                        print(f"[CHAIN] rva=0x{actor_rva:X} actor_sys_class={hex(actor_sys_class) if actor_sys_class else 0}", flush=True)
                        print(f"[CHAIN] actor_sys_self={hex(actor_sys_self) if actor_sys_self else 0}", flush=True)
                        print(f"[CHAIN] local_player  ={hex(local_player) if local_player else 0}", flush=True)
                        print(f"[CHAIN] actor_control ={hex(actor_control) if actor_control else 0} (off=0x{getattr(self,'_cached_ac_off',0):X})", flush=True)
                        print(f"[CHAIN] kinematic_ptr ={hex(kinematic_ptr) if kinematic_ptr else 0} (off=0x{getattr(self,'_cached_kin_off',0):X})", flush=True)
                        print(f"[CHAIN] motor_ptr     ={hex(motor_ptr) if motor_ptr else 0} (off=0x{getattr(self,'_cached_mot_off',0):X})", flush=True)

                if motor_ptr and 0x10000 < motor_ptr < 0x7FFFFFFFFFFF:
                    px = self._read_float(motor_ptr + 0x100)
                    py = self._read_float(motor_ptr + 0x104)
                    pz = self._read_float(motor_ptr + 0x108)

                    self.pos_x, self.pos_y, self.pos_z = px, py, pz
                    self.local_player_addr  = local_player
                    self.actor_control_addr = actor_control
                    self.kinematic_addr     = kinematic_ptr
                    self.motor_addr         = motor_ptr
                    self.signals.update_coords.emit(px, py, pz, True, motor_ptr)

                elif actor_control and 0x10000 < actor_control < 0x7FFFFFFFFFFF:
                    px = self._read_float(actor_control + 0x120)
                    py = self._read_float(actor_control + 0x124)
                    pz = self._read_float(actor_control + 0x128)
                    self.pos_x, self.pos_y, self.pos_z = px, py, pz
                    self.local_player_addr  = local_player
                    self.actor_control_addr = actor_control
                    self.kinematic_addr     = kinematic_ptr
                    self.motor_addr         = 0
                    self.signals.update_coords.emit(px, py, pz, True, 0)
                else:
                    self.local_player_addr  = 0
                    self.actor_control_addr = 0
                    self.kinematic_addr     = 0
                    self.motor_addr         = 0
                    self._chain_debug_printed = False  # Reset flag để khi load map xong sẽ in lại thông tin địa chỉ mới
                    self.signals.update_coords.emit(0.0, 0.0, 0.0, True, 0)

            except Exception:
                pass
            time.sleep(0.04)

    def _find_pid(self, name='PlayTogether'):
        clean_name = name.replace('.exe', '')
        try:
            out = subprocess.check_output(['powershell', '-Command', f"(Get-Process '{clean_name}' -ErrorAction SilentlyContinue).Id"], text=True)
            for line in out.splitlines():
                line = line.strip()
                if line.isdigit():
                    return int(line)
        except Exception: pass

        try:
            out = subprocess.check_output(['tasklist', '/NH', '/FO', 'CSV'], text=True)
            for line in out.splitlines():
                parts = line.strip().strip('"').split('","')
                if len(parts) >= 2 and clean_name.lower() in parts[0].lower():
                    try: return int(parts[1])
                    except: pass
        except Exception: pass
        return None

    def _read_mem(self, addr, size):
        if not self.h_proc or not addr: return None
        buf = ctypes.create_string_buffer(size)
        read = ctypes.c_size_t(0)
        ok = kernel32.ReadProcessMemory(self.h_proc, ctypes.c_void_p(addr), buf, size, ctypes.byref(read))
        return buf.raw[:read.value] if ok and read.value > 0 else None

    def _write_mem(self, addr, data):
        if not self.h_proc or not addr or not (0x10000 < addr < 0x7FFFFFFFFFFF): return False
        try:
            buf = ctypes.create_string_buffer(data)
            written = ctypes.c_size_t(0)
            ok = kernel32.WriteProcessMemory(self.h_proc, ctypes.c_void_p(addr), buf, len(data), ctypes.byref(written))
            return ok and written.value == len(data)
        except Exception:
            return False

    def _read_ptr(self, addr):
        d = self._read_mem(addr, 8)
        return struct.unpack('<Q', d)[0] if (d and len(d) == 8) else 0

    def _read_float(self, addr):
        d = self._read_mem(addr, 4)
        return struct.unpack('<f', d)[0] if (d and len(d) == 4) else 0.0

    def _write_float(self, addr, val):
        if not (0x10000 < addr < 0x7FFFFFFFFFFF): return False
        try:
            d = struct.pack('<f', float(val))
            return self._write_mem(addr, d)
        except Exception:
            return False

    # ─────────────────────────────────────────────────────────────
    #  Dynamic RVA Scanner — tự tìm RVA khi game update
    # ─────────────────────────────────────────────────────────────
    def _scan_rva_for_class_name(self, target_name: str) -> int:
        """Quét GameAssembly.dll để tìm RVA của Il2Cpp class TypeInfo theo tên."""
        if not self.h_proc or not self.ga_base:
            return 0
        try:
            dos_hdr = self._read_mem(self.ga_base, 0x40)
            if not dos_hdr:
                return 0
            e_lfanew = struct.unpack_from('<I', dos_hdr, 0x3c)[0]
            pe_hdr = self._read_mem(self.ga_base + e_lfanew, 0x100)
            if not pe_hdr:
                return 0
            ga_size = struct.unpack_from('<I', pe_hdr, 0x50)[0]
            if ga_size <= 0:
                return 0

            needle_str = target_name.encode('utf-8') + b'\x00'
            ga_bytes = bytearray(ga_size)
            CHUNK = 4 * 1024 * 1024
            for off in range(0, ga_size, CHUNK):
                sz = min(CHUNK, ga_size - off)
                data = self._read_mem(self.ga_base + off, sz)
                if data:
                    ga_bytes[off:off + len(data)] = data

            str_idx = ga_bytes.find(needle_str)
            if str_idx == -1:
                return 0

            s_addr = self.ga_base + str_idx
            needle_ptr = struct.pack('<Q', s_addr)

            cls_rva = -1
            p = 0
            while True:
                idx = ga_bytes.find(needle_ptr, p)
                if idx == -1:
                    break
                candidate_cls = idx - 0x10
                if candidate_cls >= 0 and candidate_cls + 0x100 <= ga_size:
                    field_count = struct.unpack_from('<H', ga_bytes, candidate_cls + 0xF8)[0]
                    if 0 < field_count < 4000:
                        cls_rva = candidate_cls
                        break
                p = idx + 1

            if cls_rva == -1:
                return 0

            cls_addr = self.ga_base + cls_rva
            needle_cls = struct.pack('<Q', cls_addr)

            p = 0
            while True:
                idx = ga_bytes.find(needle_cls, p)
                if idx == -1:
                    break
                if idx != cls_rva:
                    return idx
                p = idx + 1
        except Exception:
            pass
        return 0

    def _get_actor_system_rva(self):
        # Kiểm tra cache còn valid không
        if self._cached_actor_rva and self.ga_base:
            rva_class_ptr = self.ga_base + self._cached_actor_rva
            actor_sys_class = self._read_ptr(rva_class_ptr)
            static_fields = self._read_ptr(actor_sys_class + 0xB8) if actor_sys_class else 0
            if static_fields and 0x10000 < static_fields < 0x7FFFFFFFFFFF:
                return self._cached_actor_rva
            else:
                self._cached_actor_rva = None  # cache lỗi thời, cần tìm lại

        # Thử các RVA đã biết (từ cũ đến mới)
        known_rvas = [0x7C8AB58, 0x7C20238, 0x6E5F630]
        if self.ga_base:
            for rva in known_rvas:
                rva_class_ptr = self.ga_base + rva
                actor_sys_class = self._read_ptr(rva_class_ptr)
                if not actor_sys_class:
                    continue
                static_fields = self._read_ptr(actor_sys_class + 0xB8)
                if static_fields and 0x10000 < static_fields < 0x7FFFFFFFFFFF:
                    self._cached_actor_rva = rva
                    print(f"[+] ActorSystem RVA tìm thấy (static): 0x{rva:X}", flush=True)
                    return rva

            # Tất cả RVA tĩnh đều thất bại → quét động
            print("[*] Tất cả RVA tĩnh thất bại, đang quét GameAssembly...", flush=True)
            scanned_rva = self._scan_rva_for_class_name("ActorSystem")
            if scanned_rva > 0:
                self._cached_actor_rva = scanned_rva
                print(f"[Auto-Adapt] ActorSystem RVA mới: 0x{scanned_rva:X}", flush=True)
                return scanned_rva

        # Fallback
        return 0x7C8AB58

    def _get_camera_vectors(self):
        import math
        if not self.ga_base: return None
        cam_rvas = [0x7C0D1F8, 0x7C0CD60, 0x7BA23C0]
        for rva in cam_rvas:
            try:
                core_class = self._read_ptr(self.ga_base + rva)
                if not core_class: continue
                core_static = self._read_ptr(core_class + 0xB8)
                if not core_static: continue
                core_inst = self._read_ptr(core_static + 0x8)
                if not core_inst: continue

                # Try active CinemachineBrain
                brain_list = self._read_ptr(core_inst + 0x10)
                if brain_list:
                    items = self._read_ptr(brain_list + 0x10)
                    brain = self._read_ptr(items + 0x20) if items else 0
                    if 0x10000 < brain < 0x7FFFFFFFFFFF:
                        qx = self._read_float(brain + 0x108)
                        qy = self._read_float(brain + 0x10C)
                        qz = self._read_float(brain + 0x110)
                        qw = self._read_float(brain + 0x114)
                        qmag = qx*qx + qy*qy + qz*qz + qw*qw
                        if 0.90 <= qmag <= 1.10:
                            cam_fx = 2.0 * (qx * qz + qw * qy)
                            cam_fz = 1.0 - 2.0 * (qx * qx + qy * qy)
                            len_f = math.sqrt(cam_fx * cam_fx + cam_fz * cam_fz)
                            if len_f > 0.0001:
                                cam_fx /= len_f
                                cam_fz /= len_f
                            cam_rx = cam_fz
                            cam_rz = -cam_fx
                            return cam_fx, cam_fz, cam_rx, cam_rz

                # Fallback to active VCam
                vcam = self._read_ptr(core_inst + 0x30)
                if 0x10000 < vcam < 0x7FFFFFFFFFFF:
                    qx = self._read_float(vcam + 0x160)
                    qy = self._read_float(vcam + 0x164)
                    qz = self._read_float(vcam + 0x168)
                    qw = self._read_float(vcam + 0x16C)
                    qmag = qx*qx + qy*qy + qz*qz + qw*qw
                    if 0.90 <= qmag <= 1.10:
                        cam_fx = 2.0 * (qx * qz + qw * qy)
                        cam_fz = 1.0 - 2.0 * (qx * qx + qy * qy)
                        len_f = math.sqrt(cam_fx * cam_fx + cam_fz * cam_fz)
                        if len_f > 0.0001:
                            cam_fx /= len_f
                            cam_fz /= len_f
                        cam_rx = cam_fz
                        cam_rz = -cam_fx
                        return cam_fx, cam_fz, cam_rx, cam_rz
            except Exception:
                pass
        return None

    def _attach_game(self):
        self.pid = self._find_pid('PlayTogether.exe')
        if not self.pid: return False

        if self.h_proc:
            try: kernel32.CloseHandle(self.h_proc)
            except: pass

        self.h_proc = kernel32.OpenProcess(PROCESS_REQUIRED_ACCESS, False, self.pid)
        if not self.h_proc: return False

        buf = (ctypes.c_void_p * 1024)()
        needed = ctypes.c_ulong(0)
        PSAPI.EnumProcessModules(self.h_proc, buf, ctypes.sizeof(buf), ctypes.byref(needed))
        count = needed.value // ctypes.sizeof(ctypes.c_void_p)
        GetModuleFileNameExA = PSAPI.GetModuleFileNameExA

        self.ga_base = None
        for i in range(count):
            mod_base = buf[i]
            name_buf = ctypes.create_string_buffer(260)
            GetModuleFileNameExA(self.h_proc, ctypes.c_void_p(mod_base), name_buf, 260)
            if 'GameAssembly' in name_buf.value.decode('latin-1', errors='replace'):
                self.ga_base = mod_base
                break

        return self.ga_base is not None

